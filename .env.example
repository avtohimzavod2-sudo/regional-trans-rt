# --- Database ---
# For local development, use the contour in compose.yaml. `docker compose up -d`
# then `npm run db:setup`. Port 55432, not 5432, so a Postgres you already had
# running cannot be migrated by accident:
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/regional_trans_rt"
#
# A hosted database (Neon, RDS, Supabase, ...) looks like this instead:
#   DATABASE_URL="postgresql://user:password@host:5432/regional_trans_rt?sslmode=require"
# but note that every db: script runs `npm run db:guard` first, and the guard
# refuses to migrate, push, reset or run integration tests against any host that
# is not loopback. That refusal has no override flag: touching a real database
# is a Founder decision (s.31), not an environment variable.
#
# WARNING about precedence. Next.js loads .env.local ahead of .env; the Prisma
# CLI reads .env and does not load .env.local at all. So if the two files name
# different databases, `npm run dev` and `npm run db:migrate` are talking to
# different servers. `npm run db:guard` prints both and says which is which.

# --- Dispatcher panel auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Used only by `npm run db:seed` to create the first dispatcher login.
SEED_DISPATCHER_USERNAME="admin"
SEED_DISPATCHER_PASSWORD="changeme123"

# --- Telegram (drivers) ---
# Create a bot via @BotFather, then set the webhook to:
#   https://<your-domain>/api/webhooks/telegram
TELEGRAM_BOT_TOKEN=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value as the secret_token parameter when calling Telegram's
# setWebhook API. Every inbound POST is rejected (fail closed) if this is unset.
TELEGRAM_WEBHOOK_SECRET=""

# --- WhatsApp Cloud API (passengers) ---
# Meta for Developers -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any string you choose; must match the value you enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=""
# Meta App Secret (App Dashboard -> Settings -> Basic). Used to verify the
# X-Hub-Signature-256 header on every inbound POST. Every inbound POST is
# rejected (fail closed) if this is unset.
WHATSAPP_APP_SECRET=""

# --- AI / NLP extraction ---
# "rule-based" (default) needs no credentials and is deterministic — safe for
# dev/CI, and the reason a full passenger loop can be run end to end without
# spending anything. It parses ru/ky/en against the corridor stop list and says
# UNRECOGNIZED rather than guessing. Set to "anthropic" only once
# ANTHROPIC_API_KEY below is a real key; a key alone is not enough, so a stray
# credential in the environment can never start billing by itself.
RT_NLP_PROVIDER="rule-based"
# Anthropic API key (used directly here; swap for Vercel AI Gateway if preferred).
ANTHROPIC_API_KEY=""

# --- Mira (Kontakter RT) ---
# "mock" (default) needs no credentials and is deterministic — safe for dev/CI.
# Set to "google" only once MIRA_GEMINI_API_KEY below is a real key.
MIRA_AI_PROVIDER="mock"
MIRA_GEMINI_MODEL="gemini-flash-latest"
MIRA_GEMINI_API_KEY=""
# Voice-message understanding provider. "mock" (default) needs no credentials;
# "google" requires MIRA_GEMINI_API_KEY above. Real voice ingestion is not yet
# wired into the Telegram/WhatsApp webhooks — this is architecture only.
MIRA_AUDIO_PROVIDER="mock"

# --- Жолчу (Jolchu) — Route Intelligence Agent ---
# Separate specialized agent, NOT part of Mira. Mira calls it only for
# LOCATION_RESOLUTION / ROUTE_CALCULATION / TRAFFIC_CHECK / LAST_MILE /
# AMBIGUITY_CHECK — never on every message. "Maps are not an LLM": these
# model-provider vars only control language UNDERSTANDING (parsing landmarks,
# cleaning a geocode query) — actual coordinates/distance/traffic always come
# from the RouteProvider vars below, never from the LLM.
# "mock" (default) needs no credentials and is deterministic — safe for dev/CI.
JOLCHU_MODEL_PROVIDER="mock"
JOLCHU_PRIMARY_MODEL="gemini-flash-latest"
JOLCHU_FALLBACK_MODEL="mock"

# The single source of truth for real geography (geocoding + road routing).
# "mock" (default) needs no API keys and never fabricates live traffic.
JOLCHU_ROUTE_PROVIDER="mock"
JOLCHU_ROUTE_FALLBACK_PROVIDER=""
GOOGLE_MAPS_API_KEY=""
TWO_GIS_API_KEY=""

# Jolchu policy knobs — pure geo/confidence thresholds, never commercial logic.
JOLCHU_CONFIRMATION_CONFIDENCE_THRESHOLD="0.6"
JOLCHU_LAST_MILE_THRESHOLD_KM="5"
# Mandatory cadence for refreshing Jolchu's reference data (known hubs/
# landmarks, provider capability snapshot) — NOT live traffic, which always
# stays real-time per request.
JOLCHU_DATA_REFRESH_INTERVAL_DAYS="30"

# --- Artur (Director) ---
# "mock" (default) needs no credentials and is deterministic — safe for dev/CI.
# Set to "anthropic" only once ANTHROPIC_API_KEY above is a real key.
ARTUR_AI_PROVIDER="mock"
ARTUR_CLAUDE_MODEL="claude-sonnet-5"
# Used only by `npm run db:seed` to create the first Founder login.
SEED_FOUNDER_USERNAME="founder"
SEED_FOUNDER_PASSWORD="changeme123"
# Shared secret the /api/cron/artur-* routes require in an Authorization
# header, so a scheduler (Vercel Cron or otherwise) is the only caller that
# can trigger a daily/weekly generation run. Unset in dev — the routes then
# refuse scheduled calls and only the dispatcher "generate now" buttons work.
CRON_SECRET=""
