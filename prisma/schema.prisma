// Regional Trans RT — dispatching engine data model.
// Regional Trans is an information intermediary, not a carrier: the carriage
// contract is formed directly between passenger and driver once a match is confirmed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  RU
  KY
  EN
}

enum Channel {
  WHATSAPP
  TELEGRAM_BOT
  TELEGRAM_GROUP
}

enum DriverStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum RequestStatus {
  PENDING
  MATCHING
  MATCHED
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum OfferStatus {
  OPEN
  PARTIALLY_FILLED
  FULL
  CLOSED
  CANCELLED
}

enum MatchStatus {
  PROPOSED_TO_DRIVER
  AWAITING_DRIVER
  AWAITING_PASSENGER
  CONFIRMED
  DECLINED_BY_DRIVER
  DECLINED_BY_PASSENGER
  EXPIRED
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MessageParseResult {
  PASSENGER_REQUEST
  DRIVER_OFFER
  CONFIRMATION_REPLY
  UNRECOGNIZED
  COMMAND
  IGNORED_NOT_ALLOWED
}

// Passenger<->Driver operational loop (RT OFFICE orchestration/observability
// layer). Additive on top of the real matching engine — never a second
// matching engine: every status here is *derived from and driven by* real
// TripRequest/Match transitions in matching/orchestrate.ts, never invented
// independently. See src/lib/rt-office/passenger-loop.ts.
enum PassengerLoopStatus {
  NEW
  NORMALIZED
  SUPPLY_REQUESTED
  MATCHING
  OFFER_READY
  NO_SUPPLY
  OFFER_SENT
  PASSENGER_ACCEPTED
  PASSENGER_DECLINED
  EXPIRED
  CANCELLED
}

enum PassengerLoopOfferStatus {
  CANDIDATE
  VALIDATED
  RESERVED_PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  INVALIDATED
}

// Fail-closed reason for NO_SUPPLY — chosen by the actual situation
// (src/lib/rt-office/passenger-loop.ts), never defaulted blindly.
enum NoSupplyReason {
  NO_SUPPLY
  TEMPORARILY_UNAVAILABLE
  NEEDS_CLARIFICATION
}

// One row per TripRequest (1:1) — the passenger-facing loop's own status,
// observability, and fail-closed reasoning, layered on top of the real
// TripRequest/Match state it reads and reacts to. Never a second source of
// truth for seat/driver/trip facts: those stay exclusively in
// TripRequest/Match/Trip/DriverOffer.
model PassengerLoopRun {
  id              String              @id @default(cuid())
  tripRequestId   String              @unique
  tripRequest     TripRequest         @relation(fields: [tripRequestId], references: [id])
  correlationId   String              @unique // root AgentContext.traceId for this passenger demand
  status          PassengerLoopStatus @default(NEW)
  noSupplyReason  NoSupplyReason?
  noSupplyDetail  String? // free-text diagnostic (e.g. "JOLCHU_TIMEOUT", "CRM_AUTO_TIMEOUT") — never a second enum
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  offers PassengerLoopOffer[]

  @@index([status])
}

// One row per Match the loop run has gone through (a passenger can be
// rematched after a decline/expiry, so this is 1:N, not 1:1). matchId/
// driverOfferId are loose references (no FK), mirroring DriveCrmEvent's
// established convention — this table observes the real Match, it never
// owns or mutates it.
model PassengerLoopOffer {
  id          String                   @id @default(cuid())
  loopRunId   String
  loopRun     PassengerLoopRun         @relation(fields: [loopRunId], references: [id])
  matchId     String                   @unique
  driverOfferId String
  status      PassengerLoopOfferStatus @default(CANDIDATE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([loopRunId])
}

enum ActorType {
  AGENT
  DISPATCHER
  SYSTEM
}

// RT AI Workforce — named specialist agents orchestrated by RT Command.
// MIRA is the single public-facing "Контактер RT" persona — see src/lib/mira.
// She sits in front of COMMAND for conversational channels; she does not
// replace COMMAND as the internal orchestrator.
enum AgentName {
  COMMAND
  PASSENGER
  DRIVER
  MATCH
  ROUTE
  TRUST
  PAY
  SUPPORT
  PARCEL
  SCOUT
  QUALITY
  ANALYTICS
  NETWORK
  MIRA
  JOLCHU
  SAPAR
  SAPARGUL
  ADILET
  TYYIN
  ARTUR
  RT_OFFICE
  CRM_AUTO
  DRIVER_CONTRACTOR
  PASSENGER_CONTRACTOR
  DELIVERY_CONTRACTOR
  DELIVERY_EXECUTOR_CONTRACTOR
  CARGO_CARRIER_CONTRACTOR
}

enum PaymentMode {
  DRIVER_DIRECT_RT_BALANCE // driver collects fare in person; RT debits driver's RT Balance for the commission
  THROUGH_RT // passenger pays RT; RT keeps commission and pays out the remainder to the driver
}

enum LedgerEntryType {
  COMMISSION_CHARGE
  TOPUP
  PAYMENT_COLLECTED
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum LedgerEntryStatus {
  POSTED
  REVERSED
}

enum ParcelStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  DISPUTED
}

enum ScoutSourceType {
  TELEGRAM_GROUP
  WHATSAPP_GROUP
  LALAFO
  MANUAL_IMPORT
  INTERNAL
}

enum ScoutReviewStatus {
  PENDING_REVIEW
  AUTO_LINKED
  MANUALLY_LINKED
  REJECTED
  NEW_DRIVER_CREATED
}

enum DriverCategory {
  UNKNOWN
  OCCASIONAL
  REGULAR
  ANCHOR
  DISPATCHER_FLEET
}

enum SupportCaseType {
  DRIVER_NO_SHOW
  PASSENGER_NO_SHOW
  CANCELLATION
  LATE
  DISPUTE
  REFUND_REQUEST
  ROUTE_CHANGE
  OTHER
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum PartnerType {
  DRIVER_FLEET
  DISPATCHER
  RT_POINT
  CAFE
  GAS_STATION
  SUPERMARKET
  COURIER
  LAST_MILE
  OTHER
}

// Ordered corridor of stops, e.g. Bishkek -> Balykchy -> Cholpon-Ata -> Bosteri -> Karakol.
// Direction of travel is inferred by comparing `order` of origin vs destination stop.
model Corridor {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "bishkek-karakol"
  nameRu    String
  nameKy    String
  nameEn    String
  isActive  Boolean  @default(true)
  stops     Stop[]
  createdAt DateTime @default(now())
}

model Stop {
  id         String   @id @default(cuid())
  corridorId String
  corridor   Corridor @relation(fields: [corridorId], references: [id])
  key        String // e.g. "bishkek", "balykchy", "cholpon-ata", "bosteri", "karakol"
  nameRu     String
  nameKy     String
  nameEn     String
  order      Int // position along the corridor, ascending
  aliases    String[] // free-text aliases/spellings used by NLP matching

  requestsAsOrigin      TripRequest[] @relation("RequestOrigin")
  requestsAsDestination TripRequest[] @relation("RequestDestination")
  offersAsOrigin        DriverOffer[] @relation("OfferOrigin")
  offersAsDestination   DriverOffer[] @relation("OfferDestination")
  parcelsAsOrigin       Parcel[]      @relation("ParcelOrigin")
  parcelsAsDestination  Parcel[]      @relation("ParcelDestination")
  partners              Partner[]

  @@unique([corridorId, key])
  @@index([corridorId, order])
}

model Passenger {
  id            String        @id @default(cuid())
  whatsappId    String        @unique // WhatsApp wa_id (phone-linked)
  phone         String? // E.164, may equal whatsappId; kept private, only shared on confirmed match
  name          String?
  preferredLang Language      @default(RU)
  isBlocked     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  requests      TripRequest[]
  trips         Trip[]
}

model Driver {
  id                String           @id @default(cuid())
  telegramUserId    String           @unique
  telegramUsername  String?
  phone             String? // private, shared with passenger only on confirmed match
  name              String?
  carModel          String?
  carPlate          String?
  preferredLang     Language         @default(RU)
  status            DriverStatus     @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?
  verifiedByAdminId String?
  isFemale          Boolean? // self-declared, opt-in; used only to honor passenger safety preferences
  ratingAvg         Float?
  ratingCount       Int              @default(0)
  complaintsCount   Int              @default(0)
  repeatScore       Int              @default(0) // RT Scout: signals of being a recurring driver on this corridor
  category          DriverCategory   @default(UNKNOWN)
  lastScoutSeenAt   DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  offers            DriverOffer[]
  trips             Trip[]
  rtBalance         RtBalance?
  ledgerEntries     LedgerEntry[]
  scoutCandidates   ScoutCandidate[]
  parcels           Parcel[]
  driveCrmEvents    DriveCrmEvent[]
}

model TripRequest {
  id                    String        @id @default(cuid())
  passengerId           String
  passenger             Passenger     @relation(fields: [passengerId], references: [id])
  originStopId          String
  origin                Stop          @relation("RequestOrigin", fields: [originStopId], references: [id])
  destinationStopId     String
  destination           Stop          @relation("RequestDestination", fields: [destinationStopId], references: [id])
  travelDate            DateTime      @db.Date
  timeWindowStart       String? // "HH:mm", free-form time-of-day preference
  timeWindowEnd         String?
  seats                 Int           @default(1)
  luggage               String? // free-text luggage description
  pickupPoint           String? // free-text pickup detail within origin stop
  femaleOnlyDriver      Boolean       @default(false) // safety preference: only propose to a driver who declared isFemale
  travelingWithChildren Boolean       @default(false)
  status                RequestStatus @default(PENDING)
  sourceChannel         Channel       @default(WHATSAPP)
  rawMessageId          String?       @unique
  rawMessage            RawMessage?   @relation(fields: [rawMessageId], references: [id])
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  matches               Match[]
  passengerLoopRun      PassengerLoopRun?

  @@index([status, travelDate])
  @@index([originStopId, destinationStopId, travelDate])
}

model DriverOffer {
  id                  String      @id @default(cuid())
  driverId            String
  driver              Driver      @relation(fields: [driverId], references: [id])
  originStopId        String
  origin              Stop        @relation("OfferOrigin", fields: [originStopId], references: [id])
  destinationStopId   String
  destination         Stop        @relation("OfferDestination", fields: [destinationStopId], references: [id])
  travelDate          DateTime    @db.Date
  timeWindowStart     String?
  timeWindowEnd       String?
  seatsTotal          Int
  seatsAvailable      Int
  status              OfferStatus @default(OPEN)
  sourceChannel       Channel     @default(TELEGRAM_BOT)
  rawMessageId        String?     @unique
  rawMessage          RawMessage? @relation(fields: [rawMessageId], references: [id])
  isReturnLeg         Boolean     @default(false)
  generatedFromTripId String?
  generatedFromTrip   Trip?       @relation("ReturnLegSource", fields: [generatedFromTripId], references: [id])
  expiresAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  matches             Match[]
  trips               Trip[]

  @@index([status, travelDate])
  @@index([originStopId, destinationStopId, travelDate])
}

model Match {
  id                    String      @id @default(cuid())
  tripRequestId         String
  tripRequest           TripRequest @relation(fields: [tripRequestId], references: [id])
  driverOfferId         String
  driverOffer           DriverOffer @relation(fields: [driverOfferId], references: [id])
  status                MatchStatus @default(PROPOSED_TO_DRIVER)
  score                 Float? // internal ranking score for candidate selection
  proposedToDriverAt    DateTime?
  driverRespondedAt     DateTime?
  proposedToPassengerAt DateTime?
  passengerRespondedAt  DateTime?
  confirmedAt           DateTime?
  contactRevealedAt     DateTime?
  declineReason         String?
  // Deadline for whichever side the ball is currently in: driver's response
  // window while AWAITING_DRIVER, passenger's while AWAITING_PASSENGER. Null
  // once the match leaves either waiting state. The expiry sweep
  // (src/lib/matching/expiry.ts) is the only writer of the resulting EXPIRED
  // status.
  expiresAt             DateTime?
  createdAt             DateTime    @default(now())
  trip                  Trip?

  @@index([status])
  @@index([status, expiresAt])
}

model Trip {
  id                  String        @id @default(cuid())
  matchId             String        @unique
  match               Match         @relation(fields: [matchId], references: [id])
  driverId            String
  driver              Driver        @relation(fields: [driverId], references: [id])
  passengerId         String
  passenger           Passenger     @relation(fields: [passengerId], references: [id])
  driverOfferId       String
  driverOffer         DriverOffer   @relation(fields: [driverOfferId], references: [id])
  status              TripStatus    @default(SCHEDULED)
  seats               Int           @default(1) // snapshot of TripRequest.seats at confirmation, for commission/analytics
  paymentMode         PaymentMode?
  totalFareSom        Int? // optional, only meaningful for PaymentMode.THROUGH_RT
  commissionSom       Int? // snapshot of the commission charged for this trip once billed
  commissionChargedAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime      @default(now())
  returnLegOffers     DriverOffer[] @relation("ReturnLegSource")
  ledgerEntries       LedgerEntry[]
  supportCases        SupportCase[]
  parcels             Parcel[]

  @@index([status])
}

// One row per driver: running balance of commission owed to RT (negative = driver owes RT).
model RtBalance {
  id         String   @id @default(cuid())
  driverId   String   @unique
  driver     Driver   @relation(fields: [driverId], references: [id])
  balanceSom Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Append-only commission/payment ledger. Balance-affecting entries also update RtBalance.balanceSom
// transactionally; PAYMENT_COLLECTED/PAYOUT are informational records of the THROUGH_RT settlement flow.
model LedgerEntry {
  id          String            @id @default(cuid())
  driverId    String
  driver      Driver            @relation(fields: [driverId], references: [id])
  tripId      String?
  trip        Trip?             @relation(fields: [tripId], references: [id])
  type        LedgerEntryType
  status      LedgerEntryStatus @default(POSTED)
  paymentMode PaymentMode?
  amountSom   Int // signed: negative = debit from driver's RT Balance, positive = credit
  description String?
  actorType   ActorType
  actorId     String?
  createdAt   DateTime          @default(now())
  reversedAt  DateTime?

  @@index([driverId, createdAt])
  @@index([tripId])
}

model Parcel {
  id                  String       @id @default(cuid())
  senderName          String?
  senderContact       String // WhatsApp id, phone, or Telegram username of the sender
  receiverName        String?
  receiverContact     String
  originStopId        String
  origin              Stop         @relation("ParcelOrigin", fields: [originStopId], references: [id])
  destinationStopId   String
  destination         Stop         @relation("ParcelDestination", fields: [destinationStopId], references: [id])
  sizeType            String? // free-text: "document" | "small bag" | "box" etc.
  description         String?
  priceSom            Int?
  driverId            String?
  driver              Driver?      @relation(fields: [driverId], references: [id])
  tripId              String?
  trip                Trip?        @relation(fields: [tripId], references: [id])
  status              ParcelStatus @default(PENDING)
  pickupConfirmedAt   DateTime?
  deliveryConfirmedAt DateTime?
  cancelReason        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status, createdAt])
}

// RT Scout: raw driver sightings imported from Telegram/WhatsApp groups, Lalafo, or manual entry.
// Never auto-merged into a Driver record above a low confidence threshold — always reviewable.
model ScoutCandidate {
  id                   String            @id @default(cuid())
  sourceType           ScoutSourceType
  sourceGroupId        String? // TelegramGroup.id or free-text source label
  sourceText           String // raw announcement text, kept for audit/manual review
  rawPhone             String?
  rawTelegramUsername  String?
  rawName              String?
  rawCarModel          String?
  rawCarPlate          String?
  rawRouteText         String?
  rawOriginStopId      String?
  rawDestinationStopId String?
  rawTravelDate        DateTime?         @db.Date
  rawPriceSom          Int?
  rawSeats             Int?
  extractionConfidence Float?
  normalizedPhone      String? // digits-only, used as a dedup signal
  reviewStatus         ScoutReviewStatus @default(PENDING_REVIEW)
  matchCandidates      Json? // top scored Driver matches: [{ driverId, confidence, signals }]
  linkedDriverId       String?
  linkedDriver         Driver?           @relation(fields: [linkedDriverId], references: [id])
  reviewedByAdminId    String?
  reviewedAt           DateTime?
  createdAt            DateTime          @default(now())

  @@index([reviewStatus, createdAt])
  @@index([normalizedPhone])
}

model SupportCase {
  id           String            @id @default(cuid())
  tripId       String?
  trip         Trip?             @relation(fields: [tripId], references: [id])
  caseType     SupportCaseType
  status       SupportCaseStatus @default(OPEN)
  openedByType ActorType
  openedById   String?
  description  String?
  resolution   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  resolvedAt   DateTime?
  escalatedAt  DateTime?

  @@index([status, createdAt])
}

// RT Network: partner directory (fleets, dispatchers, RT Points, last-mile partners, etc).
model Partner {
  id            String      @id @default(cuid())
  type          PartnerType
  name          String
  contactPhone  String?
  contactHandle String?
  stopId        String?
  stop          Stop?       @relation(fields: [stopId], references: [id])
  notes         String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

// Telegram groups the agent is allowed to passively read, connected with admin consent.
model TelegramGroup {
  id             String       @id @default(cuid())
  chatId         String       @unique
  title          String?
  addedByAdminId String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  rawMessages    RawMessage[]
}

// Every inbound message the agent ingests, for audit + debugging NLP extraction.
model RawMessage {
  id                   String              @id @default(cuid())
  channel              Channel
  chatId               String
  telegramGroupId      String?
  telegramGroup        TelegramGroup?      @relation(fields: [telegramGroupId], references: [id])
  senderId             String
  text                 String
  detectedLanguage     Language?
  parseResult          MessageParseResult?
  extractionConfidence Float?
  extractionRaw        Json?
  createdAt            DateTime            @default(now())
  tripRequests         TripRequest[]
  driverOffers         DriverOffer[]

  @@index([channel, chatId, createdAt])
}

model AuditLogEntry {
  id         String     @id @default(cuid())
  actorType  ActorType
  actorId    String? // dispatcher user id, or "agent"/"system"
  agentName  AgentName? // which RT AI Workforce agent produced this entry, if actorType = AGENT
  traceId    String? // correlation id shared by every agent invocation within one RT Command run
  action     String // e.g. "match.proposed", "match.confirmed", "contact.revealed", "dispatcher.override"
  entityType String // e.g. "Match", "Trip", "TripRequest"
  entityId   String
  details    Json?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([traceId])
}

model DispatcherUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("dispatcher") // "dispatcher" | "admin"
  createdAt    DateTime @default(now())
}

// ==========================================================================
// MIRA — Контактер RT. Single public conversational persona in front of RT
// Command (see src/lib/mira). Everything below is additive and does not
// change any existing model. Loose string references (no FK) are used for
// analytics/log-shaped rows to match the AuditLogEntry convention already
// used elsewhere in this schema; real parent/child relations are used only
// where one row structurally owns another (conversation -> messages,
// benchmark run -> results).
// ==========================================================================

enum MiraRole {
  PASSENGER
  DRIVER
  DISPATCHER
  INTERMEDIARY
  PARCEL_SENDER
  PARTNER
  TOURIST
  UNKNOWN
}

enum MiraConversationStatus {
  ACTIVE
  AWAITING_USER
  COMPLETED
  ABANDONED
  ESCALATED
}

enum MiraSenderType {
  USER
  MIRA
  SYSTEM
}

enum MiraCertificationStatus {
  TRAINEE
  CERTIFICATION_PENDING
  CERTIFIED
  PRODUCTION_APPROVED
  SUSPENDED
}

enum MiraFailureCategory {
  LANGUAGE
  DIALECT
  CODE_SWITCH
  ROLE
  ROUTE
  DATE
  TIME
  PHONE
  PASSENGER_COUNT
  DRIVER_SEATS
  PARCEL
  VOICE
  CONTEXT
  HALLUCINATION
  UNNECESSARY_CLARIFICATION
  TONE
  SAFETY
  PAYMENT
  OTHER
}

enum MiraFailureStatus {
  OPEN
  IN_TRAINING_LOOP
  RESOLVED
}

// One conversational session with one end user on one channel. This is the
// "Mira Session" the spec calls for — the state COMMAND itself does not keep,
// since COMMAND only ever sees one message at a time.
model MiraConversation {
  id                String                 @id @default(cuid())
  channel           Channel
  externalUserId    String // whatsappId / telegramUserId — same id space ingest.ts already uses
  role              MiraRole               @default(UNKNOWN)
  detectedLanguage  Language?
  status            MiraConversationStatus @default(ACTIVE)
  activeIntent      String?
  // Mira Pass 1 spec s.3 — conversation_host is always MIRA by construction
  // (she is the only module that ever calls sendReply/sendTelegramMessage/
  // sendWhatsAppText, see src/lib/mira/sapar-bridge.ts) and is therefore not
  // its own stored field. activeSpecialist is the one piece of state that
  // does need to persist: which specialist currently owns this turn inside
  // the same chat/thread — "MIRA" or "SAPAR" today, a future specialist name
  // later. A free string (not a closed enum) so onboarding a new specialist
  // never requires a migration here.
  activeSpecialist  String                 @default("MIRA")
  collectedFields   Json? // fields Mira has extracted so far (route, date, seats, ...)
  missingFields     String[] // field names still needed before COMMAND can act
  confirmedFields   Json? // fields the user has explicitly confirmed
  lastAgentDecision String? // last CommandResult.outcome seen for this conversation
  lastTraceId       String? // most recent RT Command traceId this conversation drove
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  messages          MiraMessage[]

  @@index([channel, externalUserId, updatedAt])
  @@index([status])
}

model MiraMessage {
  id                    String           @id @default(cuid())
  conversationId        String
  conversation          MiraConversation @relation(fields: [conversationId], references: [id])
  sender                MiraSenderType
  rawText               String? // as typed by the user, or as spoken by Mira
  audioRef              String? // opaque reference to the voice attachment, if any
  transcript            String? // speech-to-text / audio-understanding output
  normalizedText        String? // Mira's normalized-meaning version of rawText/transcript
  detectedLanguage      Language?
  languageConfidence    Float?
  role                  MiraRole?
  intent                String?
  entities              Json?
  uncertainties         String[] // parts of the message Mira was not confident about
  requiresClarification Boolean          @default(false)
  traceId               String? // RT Command traceId this turn produced, if any
  createdAt             DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// Usage/observability log for every call to a MiraModelProvider /
// AudioUnderstandingProvider implementation. Deliberately loose (string
// conversationId, no FK) to match AuditLogEntry's logging convention.
model MiraProviderCall {
  id               String   @id @default(cuid())
  provider         String // "google-gemini" | "mock" | ...
  model            String
  purpose          String // "nlu" | "reply" | "audio_transcript" | ...
  conversationId   String?
  traceId          String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  estimatedCostUsd Float?
  ok               Boolean
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([provider, purpose])
}

// Curated Kyrgyz/Russian/English training corpus entry, with full provenance
// so production training data never mixes with unlicensed/unverified data.
model MiraTrainingExample {
  id                           String    @id @default(cuid())
  level                        Int // 1..30, see src/lib/mira/training/levels.ts
  category                     String?
  input                        String
  inputType                    String    @default("TEXT") // "TEXT" | "VOICE_TRANSCRIPT"
  language                     Language?
  dialect                      String?
  containsTypos                Boolean   @default(false)
  containsRussianMix           Boolean   @default(false)
  containsMissingKyrgyzLetters Boolean   @default(false)
  expectedRole                 MiraRole?
  expectedIntent               String?
  expectedNormalizedData       Json?
  source                       String // e.g. "synthetic", "rt-sanitized", "akylai-reference"
  sourceType                   String // ProvenanceMetadata.sourceType
  license                      String?
  verified                     Boolean   @default(false)
  reviewedByHuman              Boolean   @default(false)
  allowedForTraining           Boolean   @default(true)
  allowedForEvaluation         Boolean   @default(true)
  privacyStatus                String    @default("SYNTHETIC") // "SYNTHETIC" | "SANITIZED" | "REDACTION_PENDING"
  notes                        String?
  createdAt                    DateTime  @default(now())

  @@index([level])
  @@index([language])
  @@index([sourceType])
}

// A single RT Kyrgyz Benchmark case. Not a unit test — a labeled example run
// through the real Mira pipeline and scored against KPI thresholds.
model MiraBenchmarkCase {
  id                           String                @id @default(cuid())
  code                         String                @unique // e.g. "KY-LIT-001"
  input                        String
  inputType                    String                @default("TEXT")
  expectedRole                 MiraRole?
  expectedIntent               String?
  expectedLanguage             Language?
  expectedNormalizedData       Json?
  allowedAlternatives          Json?
  difficulty                   String                @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD" | "ADVERSARIAL"
  dialect                      String?
  containsTypos                Boolean               @default(false)
  containsRussianMix           Boolean               @default(false)
  containsMissingKyrgyzLetters Boolean               @default(false)
  containsVoice                Boolean               @default(false)
  sourceClass                  String                @default("SYNTHETIC")
  privacyStatus                String                @default("SYNTHETIC")
  humanVerified                Boolean               @default(false)
  tags                         String[]
  createdAt                    DateTime              @default(now())
  results                      MiraBenchmarkResult[]

  @@index([difficulty])
}

model MiraBenchmarkRun {
  id                 String                @id @default(cuid())
  provider           String
  model              String
  startedAt          DateTime              @default(now())
  finishedAt         DateTime?
  totalCases         Int                   @default(0)
  passedCases        Int                   @default(0)
  roleAccuracy       Float?
  routeAccuracy      Float?
  dateTimeAccuracy   Float?
  seatAccuracy       Float?
  phoneAccuracy      Float?
  hallucinationCount Int                   @default(0)
  overallScore       Float?
  notes              String?
  results            MiraBenchmarkResult[]
}

model MiraBenchmarkResult {
  id                   String               @id @default(cuid())
  runId                String
  run                  MiraBenchmarkRun     @relation(fields: [runId], references: [id])
  caseId               String
  case                 MiraBenchmarkCase    @relation(fields: [caseId], references: [id])
  passed               Boolean
  actualRole           MiraRole?
  actualIntent         String?
  actualNormalizedData Json?
  actualReplyText      String?
  failureCategory      MiraFailureCategory?
  details              Json?
  createdAt            DateTime             @default(now())

  @@index([runId])
  @@index([caseId])
}

// Human Language Review — a dispatcher/reviewer grading one real or
// benchmark Mira answer for grammar/naturalness/meaning/etc.
model MiraHumanReview {
  id                      String    @id @default(cuid())
  conversationId          String?
  messageId               String?
  benchmarkResultId       String?
  input                   String
  miraAnswer              String
  normalizedData          Json?
  detectedLanguage        Language?
  expectedMeaning         String?
  agentTrace              Json?
  grammar                 Int? // 1..5
  naturalness             Int? // 1..5
  meaning                 Int? // 1..5
  politeness              Int? // 1..5
  dialectUnderstanding    Int? // 1..5
  codeSwitchUnderstanding Int? // 1..5
  hallucination           Boolean   @default(false)
  overallScore            Float?
  comments                String?
  reviewedByAdminId       String?
  createdAt               DateTime  @default(now())

  @@index([createdAt])
}

// Certification history. The most recent row (by createdAt) is Mira's
// current status; never set PRODUCTION_APPROVED programmatically.
model MiraCertification {
  id                String                  @id @default(cuid())
  status            MiraCertificationStatus @default(TRAINEE)
  benchmarkRunId    String?
  roleAccuracy      Float?
  routeAccuracy     Float?
  dateTimeAccuracy  Float?
  seatAccuracy      Float?
  phoneAccuracy     Float?
  hallucinationRate Float?
  decidedByAdminId  String?
  notes             String?
  createdAt         DateTime                @default(now())

  @@index([createdAt])
}

// Training-failure loop: every detected Mira failure becomes a row here,
// then (once reviewed) a MiraBenchmarkCase / MiraTrainingExample.
model MiraLanguageFailure {
  id                      String              @id @default(cuid())
  conversationId          String?
  messageId               String?
  category                MiraFailureCategory
  inputSanitized          String
  expectedAnswer          String?
  actualAnswer            String?
  detectedLanguage        Language?
  notes                   String?
  status                  MiraFailureStatus   @default(OPEN)
  resolvedBenchmarkCaseId String?
  createdAt               DateTime            @default(now())

  @@index([status])
  @@index([category])
}

// ---------------------------------------------------------------------------
// JOLCHU (Route Intelligence Agent) — separate internal agent, NOT part of Mira.
// Mira decides NO_JOLCHU_REQUIRED / JOLCHU_REQUIRED and only ever receives back
// a normalized RouteIntelligenceResult; Jolchu never calculates a fare and never
// lets an LLM invent coordinates/distance/duration — those come from a
// dedicated RouteProvider (Google Maps / 2GIS / Mock) abstraction only.
// ---------------------------------------------------------------------------

enum JolchuInputType {
  LIVE_LOCATION
  COORDINATES
  GOOGLE_MAPS_LINK
  TWO_GIS_LINK
  TEXT_ADDRESS
  LANDMARK
  SETTLEMENT_ONLY
  UNKNOWN
}

enum JolchuRequestStatus {
  RESOLVED
  NEEDS_CONFIRMATION
  PARTIAL
  FAILED
}

enum TrafficStatus {
  UNKNOWN
  FREE
  LIGHT
  MODERATE
  HEAVY
  SEVERE
}

enum JolchuRefreshStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model JolchuRequest {
  id                   String              @id @default(cuid())
  traceId              String?
  conversationId       String? // loose reference to a Mira conversation, if any
  reasonCode           String // LOCATION_RESOLUTION | ROUTE_CALCULATION | TRAFFIC_CHECK | LAST_MILE | AMBIGUITY_CHECK
  inputType            JolchuInputType
  rawInputSanitized    String
  status               JolchuRequestStatus
  confidence           Float?
  ambiguity            Boolean             @default(false)
  requiresConfirmation Boolean             @default(false)
  warnings             String[]
  errorMessage         String?
  latencyMs            Int?
  createdAt            DateTime            @default(now())

  resolvedLocations JolchuResolvedLocation[]
  routeCalculation  JolchuRouteCalculation?

  @@index([createdAt])
  @@index([reasonCode])
  @@index([status])
}

model JolchuResolvedLocation {
  id               String          @id @default(cuid())
  requestId        String
  request          JolchuRequest   @relation(fields: [requestId], references: [id])
  role             String // ORIGIN | DESTINATION | WAYPOINT | SINGLE
  latitude         Float?
  longitude        Float?
  formattedAddress String?
  country          String?
  region           String?
  district         String?
  settlement       String?
  locality         String?
  street           String?
  house            String?
  landmark         String?
  provider         String // "mock" | "google-maps" | "two-gis" | "device-gps" | "parsed"
  confidence       Float
  ambiguity        Boolean         @default(false)
  sourceType       JolchuInputType
  createdAt        DateTime        @default(now())

  @@index([requestId])
}

model JolchuRouteCalculation {
  id                      String        @id @default(cuid())
  requestId               String        @unique
  request                 JolchuRequest @relation(fields: [requestId], references: [id])
  provider                String
  roadDistanceKm          Float?
  straightLineDistanceKm  Float?
  estimatedDurationMin    Float?
  trafficAwareDurationMin Float?
  trafficStatus           TrafficStatus @default(UNKNOWN)
  trafficDelayMinutes     Float?
  tollFlag                Boolean       @default(false)
  ferryFlag               Boolean       @default(false)
  unpavedRoadFlag         Boolean       @default(false)
  roadClosureFlag         Boolean       @default(false)
  mainRouteDistanceKm     Float?
  lastMileDetected        Boolean       @default(false)
  lastMileDistanceKm      Float?
  totalDistanceKm         Float?
  confidence              Float?
  warnings                String[]
  calculatedAt            DateTime      @default(now())

  segments JolchuRouteSegmentRecord[]

  @@index([requestId])
}

model JolchuRouteSegmentRecord {
  id                 String                 @id @default(cuid())
  routeCalculationId String
  routeCalculation   JolchuRouteCalculation @relation(fields: [routeCalculationId], references: [id])
  order              Int
  kind               String // MAIN | LAST_MILE | WAYPOINT_LEG
  fromLabel          String?
  toLabel            String?
  distanceKm         Float?
  durationMin        Float?

  @@index([routeCalculationId])
}

// Log-shaped, loose reference (no FK) — mirrors the MiraProviderCall convention:
// every attempt against a model or route provider, including fallback hops.
model JolchuProviderExecution {
  id           String   @id @default(cuid())
  requestId    String?
  kind         String // MODEL | ROUTE
  provider     String
  purpose      String // understand | geocode | route | traffic | refresh
  attemptOrder Int      @default(1) // 1 = primary, 2 = fallback, ...
  ok           Boolean
  latencyMs    Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([requestId])
  @@index([provider, purpose])
  @@index([createdAt])
}

// Log-shaped, loose reference — mirrors the MiraLanguageFailure convention.
// Every ambiguous location (e.g. "Аламедин" = market / district / village)
// lands here for dispatcher review instead of Jolchu silently guessing.
model JolchuLocationAmbiguity {
  id            String   @id @default(cuid())
  requestId     String?
  rawInput      String
  candidates    Json // [{ label, latitude, longitude, confidence }]
  confidence    Float
  status        String   @default("OPEN") // OPEN | CONFIRMED | DISMISSED
  resolvedLabel String?
  createdAt     DateTime @default(now())

  @@index([requestId])
  @@index([status])
}

model JolchuBenchmarkCase {
  id                     String          @id @default(cuid())
  code                   String          @unique
  description            String
  inputType              JolchuInputType
  rawInput               String
  expectedJolchuRequired Boolean
  expectedReasonCode     String?
  expectedStatus         String?
  expectedSourceType     String?
  difficulty             String          @default("MEDIUM")
  tags                   String[]
  createdAt              DateTime        @default(now())

  results JolchuBenchmarkResult[]

  @@index([difficulty])
}

model JolchuBenchmarkRun {
  id                         String    @id @default(cuid())
  modelProvider              String
  routeProvider              String
  startedAt                  DateTime  @default(now())
  finishedAt                 DateTime?
  totalCases                 Int       @default(0)
  passedCases                Int       @default(0)
  routingDecisionAccuracy    Float?
  locationResolutionAccuracy Float?
  routeCalculationAccuracy   Float?
  fallbackHandledCorrectly   Float?
  hallucinationCount         Int       @default(0)
  overallScore               Float?
  notes                      String?

  results JolchuBenchmarkResult[]
}

model JolchuBenchmarkResult {
  id        String              @id @default(cuid())
  runId     String
  run       JolchuBenchmarkRun  @relation(fields: [runId], references: [id])
  caseId    String
  case      JolchuBenchmarkCase @relation(fields: [caseId], references: [id])
  passed    Boolean
  details   Json?
  createdAt DateTime            @default(now())

  @@index([runId])
  @@index([caseId])
}

// Mandatory monthly refresh of reference/operational data (settlements, known
// hubs/landmarks, provider capabilities/config, benchmark cases) — NOT live
// traffic/ETA, which always stays real-time per request.
model JolchuDataRefreshRun {
  id               String              @id @default(cuid())
  status           JolchuRefreshStatus
  refreshVersion   String
  providerSnapshot Json?
  triggeredBy      String // "manual" | "scheduler" (scheduler not wired yet)
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?
  errors           String[]
  notes            String?

  @@index([startedAt])
}

// ==========================================================================
// SAPAR — RT AI Workforce cargo/parcel delivery orchestrator (src/lib/sapar).
// Additive only: does NOT touch the existing Parcel model / PARCEL agent,
// which stays a separate, narrower flow bound to Corridor/Stop geography and
// RT's own Driver/Trip records. Sapar's hybrid multi-executor, multi-leg,
// free-text-geography model (private drivers, RT's own couriers, external
// delivery services, RT partners) needs its own domain — hence no
// Stop/Corridor/Driver relations here on purpose. Loose string references
// (no FK) are used for log-shaped/cross-module pointers (conversationId,
// partnerId), matching the AuditLogEntry convention already used elsewhere;
// real parent/child relations are used only where one row structurally owns
// another (shipment -> legs, shipment -> quotes, shipment -> incidents).
// ==========================================================================

enum ShipmentStatus {
  DRAFT
  NEEDS_INFO
  READY_FOR_MATCHING
  SEARCHING
  QUOTED
  AWAITING_CONFIRMATION
  CONFIRMED
  AWAITING_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_TRANSFER_POINT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  DISPUTED
}

enum ShipmentRiskLevel {
  LOW
  ELEVATED
  BLOCKED
}

enum ShipmentLegKind {
  PICKUP
  INTERCITY
  LAST_MILE
  TRANSFER
  SELF_DROPOFF
  SELF_PICKUP
}

enum ShipmentLegStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ShipmentQuoteSource {
  ESTIMATE
  CONFIRMED
  MANUAL
}

enum ShipmentQuoteStatus {
  OFFERED
  RECOMMENDED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DeliveryExecutorSource {
  GROUP
  DIRECT_RT_PARTNER
  RT_COURIER
  EXTERNAL_DELIVERY_SERVICE
  TAXI_PARTNER
  OTHER
}

enum DeliveryExecutorStatus {
  ACTIVE
  LIMITED
  SUSPENDED
  BLOCKED
}

// Trust tier — distinct from DeliveryExecutorStatus (active/suspended/etc.).
// A Telegram/WhatsApp group is a signal source, never an automatically
// "verified partner" (AGENTS hardening spec s.10): only RT's own vetting
// moves an executor from UNVERIFIED to PROVISIONAL/VERIFIED.
enum DeliveryExecutorVerification {
  VERIFIED
  PROVISIONAL
  UNVERIFIED
}

enum ShipmentIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShipmentIncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

// A single delivery request end to end: Sapar's normalized order. Free-text
// geography by design — no Stop/Corridor dependency, so Sapar is never
// hardcoded to the pilot corridor and can expand beyond Kyrgyzstan later.
model Shipment {
  id             String   @id @default(cuid())
  publicId       String   @unique // short customer-facing reference, e.g. "SPR-4F92K1A9"
  conversationId String? // MiraConversation.id, loose ref — Mira owns that table
  channel        Channel
  language       Language

  senderContact    String // WhatsApp id / phone / Telegram username of whoever is asking
  pickupText       String // free-text pickup location, as given by the customer
  pickupContact    String?
  destinationText  String // free-text destination
  recipientContact String?

  cargoDescription      String?
  pieces                Int?
  weightKg              Float?
  dimensions            String? // free text, e.g. "40x30x20"
  declaredValueSom      Int?
  fragile               Boolean @default(false)
  perishable            Boolean @default(false)
  temperatureControlled Boolean @default(false)
  specialHandling       String?

  preferredPickupTime String? // free text ("завтра утром") — no route/time-window engine yet
  deliveryDeadline    DateTime?
  serviceLevel        String    @default("STANDARD") // STANDARD | EXPRESS
  doorToDoor          Boolean   @default(true)

  riskLevel  ShipmentRiskLevel @default(LOW)
  riskFlags  String[]
  riskReason String?

  status             ShipmentStatus    @default(DRAFT)
  missingFields      String[] // fields Sapar still needs from the customer
  selectedQuoteId    String? // ShipmentQuote.id, resolved by the app — see src/lib/sapar
  assignedExecutorId String?
  assignedExecutor   DeliveryExecutor? @relation(fields: [assignedExecutorId], references: [id])

  cancelReason String?
  traceId      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  legs      ShipmentLeg[]
  quotes    ShipmentQuote[]
  incidents ShipmentIncident[]
  payment   ShipmentPayment?

  @@index([status, createdAt])
  @@index([senderContact])
  @@index([conversationId])
}

model ShipmentLeg {
  id              String            @id @default(cuid())
  shipmentId      String
  shipment        Shipment          @relation(fields: [shipmentId], references: [id])
  sequence        Int // 0-based order within the shipment's delivery plan
  kind            ShipmentLegKind
  originText      String
  destinationText String
  executorId      String?
  executor        DeliveryExecutor? @relation(fields: [executorId], references: [id])
  status          ShipmentLegStatus @default(PLANNED)
  plannedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  handoffCode     String?
  handoffNote     String?
  handoffPhotoUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([shipmentId, sequence])
  @@index([executorId])
}

// Separate ESTIMATE from CONFIRMED — Sapar must never present a hallucinated
// price as fact. priceSource records where the number actually came from.
model ShipmentQuote {
  id                  String              @id @default(cuid())
  shipmentId          String
  shipment            Shipment            @relation(fields: [shipmentId], references: [id])
  providerCode        String // "internal_mock" today; real provider codes once DeliveryProviderAdapter has live integrations
  executorId          String?
  executor            DeliveryExecutor?   @relation(fields: [executorId], references: [id])
  priceSom            Int?
  currency            String              @default("KGS")
  priceSource         ShipmentQuoteSource
  estimatedPickupAt   DateTime?
  estimatedDeliveryAt DateTime?
  serviceType         String
  doorToDoor          Boolean             @default(true)
  lastMileIncluded    Boolean             @default(true)
  confidence          Float?
  rankScore           Float?
  rankReasons         String[] // e.g. DIRECT_ROUTE, HIGH_RELIABILITY, LOW_PRICE, FAST_PICKUP, DOOR_TO_DOOR, FEWER_HANDOFFS, VERIFIED_PARTNER
  restrictions        String?
  cancellationTerms   String?
  notes               String?
  status              ShipmentQuoteStatus @default(OFFERED)
  createdAt           DateTime            @default(now())

  @@index([shipmentId, status])
}

// Unified provider/executor directory across all four hybrid-network sources
// (private group drivers, RT's own couriers, external delivery services, RT
// partners). partnerId is a loose pointer into RT Network's Partner
// directory (no FK — that table isn't owned by Sapar).
model DeliveryExecutor {
  id                 String                       @id @default(cuid())
  source             DeliveryExecutorSource
  name               String
  phone              String?
  company            String?
  vehicleType        String?
  zones              String[] // free-text city/region names this executor covers
  partnerId          String?
  status             DeliveryExecutorStatus       @default(ACTIVE)
  reliabilityScore   Float? // null until enough observations exist — see src/lib/sapar/executors.ts
  totalOrders        Int                          @default(0)
  completedOrders    Int                          @default(0)
  cancelledOrders    Int                          @default(0)
  lateCount          Int                          @default(0)
  complaintsCount    Int                          @default(0)
  lostCount          Int                          @default(0)
  damagedCount       Int                          @default(0)
  verificationStatus DeliveryExecutorVerification @default(UNVERIFIED)

  // Capability profile — used to exclude an executor from matching before
  // ranking ever runs, not just to break ties (AGENTS hardening spec s.9).
  maxWeightKg                  Float?
  maxPieces                    Int?
  acceptsFragile               Boolean @default(true)
  acceptsPerishable            Boolean @default(false)
  acceptsTemperatureControlled Boolean @default(false)
  servicesDoorToDoor           Boolean @default(true)
  servicesLastMile             Boolean @default(true)
  servicesIntercity            Boolean @default(true)
  servicesSameDay              Boolean @default(false)
  servicesExpress              Boolean @default(false)

  notes           String?
  blacklistReason String?
  blacklistedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shipments Shipment[]
  legs      ShipmentLeg[]
  quotes    ShipmentQuote[]

  @@index([status])
  @@index([source])
}

model ShipmentIncident {
  id           String                   @id @default(cuid())
  shipmentId   String
  shipment     Shipment                 @relation(fields: [shipmentId], references: [id])
  legId        String? // ShipmentLeg.id, loose pointer — an incident may span the whole shipment
  type         String // free-text incident type — see src/lib/sapar/incidents.ts for the known set
  severity     ShipmentIncidentSeverity
  status       ShipmentIncidentStatus   @default(OPEN)
  openedByType ActorType
  openedById   String?
  description  String?
  resolution   String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  resolvedAt   DateTime?
  escalatedAt  DateTime?

  @@index([shipmentId, status])
  @@index([severity, status])
}

// ============================================================================
// Сапаргуль — cargo/parcel payment contour (AGENTS spec "Sapargul" stage).
// ============================================================================
// THE CRITICAL INVARIANT (spec s.2/s.43): a receipt/screenshot/transaction
// id is PAYMENT EVIDENCE, never PAYMENT CONFIRMATION. The only writer of
// status = PAYMENT_CONFIRMED anywhere in this codebase is
// src/lib/sapargul/treasury.ts's confirmActualPaymentReceipt(), which is
// gated behind the "treasurer"/"admin" dispatcher role. Sapar and Sapargul's
// own operational actions can never reach that status directly.

enum ShipmentPaymentStatus {
  PAYMENT_REQUIRED
  PAYMENT_INSTRUCTIONS_READY
  AWAITING_PAYMENT
  PAYMENT_EVIDENCE_RECEIVED
  PAYMENT_REVIEW
  AWAITING_TREASURER_CONFIRMATION
  PAYMENT_CONFIRMED
  PAYMENT_MISMATCH
  PAYMENT_REJECTED
  REFUND_REQUIRED
  REFUND_PENDING
  REFUND_CONFIRMED
  CANCELLED
}

enum PaymentEvidenceType {
  RECEIPT_IMAGE
  RECEIPT_PDF
  SCREENSHOT
  TRANSACTION_REFERENCE
  TEXT_STATEMENT
}

enum PaymentPreliminaryCheckStatus {
  PENDING
  LIKELY_MATCH
  MISMATCH
  NEEDS_REVIEW
}

enum PaymentTreasuryReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentDestinationEnvironment {
  SANDBOX
  PRODUCTION
}

// Config abstraction so Sapargul never invents QR codes/requisites (spec
// s.8). In PRODUCTION, with no active destination configured, the system
// must surface PAYMENT_DESTINATION_NOT_CONFIGURED rather than fabricate one.
model PaymentDestination {
  id               String                        @id @default(cuid())
  label            String // human name, e.g. "RT Cargo — Optima Bank"
  environment      PaymentDestinationEnvironment @default(SANDBOX)
  method           String // free text: "bank_transfer" | "qr" | "mbank" | ...
  accountReference String? // masked/alias only — never full card/account secrets
  qrPayload        String? // only ever populated by an admin for a real, approved destination
  instructionsText String? // human-readable instructions template shown to the client
  isActive         Boolean                       @default(true)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  payments ShipmentPayment[]

  @@index([environment, isActive])
}

// Deliberately its own entity, not fields bolted onto Shipment (spec s.7) —
// Sapar (operational) and Sapargul (financial) contours must stay separable.
model ShipmentPayment {
  id             String   @id @default(cuid())
  shipmentId     String   @unique
  shipment       Shipment @relation(fields: [shipmentId], references: [id])
  orderReference String   @unique // customer-facing payment reference for treasury reconciliation

  amountExpectedSom Int
  currency          String                @default("KGS")
  status            ShipmentPaymentStatus @default(PAYMENT_REQUIRED)

  destinationId String?
  destination   PaymentDestination? @relation(fields: [destinationId], references: [id])

  instructionsIssuedAt DateTime?

  evidenceType         PaymentEvidenceType?
  evidenceReference    String? // opaque reference/text — never raw card/account secrets
  evidenceReceivedAt   DateTime?
  claimedAmountSom     Int?
  claimedCurrency      String?
  claimedPaymentTime   DateTime?
  transactionReference String?

  preliminaryCheckStatus PaymentPreliminaryCheckStatus @default(PENDING)
  preliminaryCheckNotes  String?
  discrepancyFlags       String[] // e.g. UNDERPAID, OVERPAID, DUPLICATE_REFERENCE, RECIPIENT_MISMATCH — see src/lib/sapargul/types.ts

  treasuryReviewStatus PaymentTreasuryReviewStatus @default(PENDING)
  treasuryReviewedAt   DateTime?
  treasuryReviewerId   String? // DispatcherUser.username of the confirming/rejecting treasurer
  confirmedAmountSom   Int?
  confirmedAt          DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  mismatchReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transactionReference])
}

// ==========================================================================
// ADILET — RT's independent dispute-resolution & disciplinary agent
// (AGENTS Adilet spec s.0-s.62). Reports only to the AI Director, never to
// any single department (spec s.3/s.25). Engages only on escalation from
// Mira/Sapar/Sapargul/Zholaman/Akzhol/the treasurer/other agents — never in
// every normal dialog (spec s.2). Additive-only: no existing model is
// altered here. Enforcement writes to Driver.status/DeliveryExecutor.status
// reuse those models' existing enums directly (spec s.33) instead of
// inventing a parallel status field; Passenger.isBlocked is set only for a
// CLIENT sanctionType=BLOCKED with a resolvable Passenger subject (spec
// s.46 explicitly excludes a larger passenger-core rework, so no new tiered
// client-access fields are added here — see src/lib/adilet/enforcement.ts).
//
// Case / Evidence / Decision / Sanction / Appeal are five distinct models
// (spec s.53), each independently indexed for the case list, subject
// lookup, and sanction-expiry queries Adilet needs at RT's 500-3000/hour
// scale (spec s.37/s.49) without a full-table scan.

enum AdiletCaseType {
  CUSTOMER_COMPLAINT
  CUSTOMER_ABUSE
  EXECUTOR_MISCONDUCT
  SERVICE_FAILURE
  PAYMENT_DISPUTE
  SAFETY_COMPLAINT
  DAMAGE_OR_LOSS
  NO_SHOW
  PRICE_DISPUTE
  CANCELLATION_DISPUTE
  AGENT_ESCALATION
  OTHER
}

// Doubles as both case severity (spec s.11) and intake priority (spec
// s.39) — RT's own CRITICAL definition (safety/violence/active fraud) is
// identical in both places, so a second near-duplicate enum would only add
// surface area without adding meaning.
enum AdiletSeverity {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AdiletCaseStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_EVIDENCE
  DECIDED
  APPEAL_REQUESTED
  UNDER_APPEAL_REVIEW
  CLOSED
}

// Escalation path ADILET_REVIEW -> DIRECTOR_REVIEW (spec s.40).
enum AdiletReviewMode {
  ADILET_REVIEW
  DIRECTOR_REVIEW
}

enum AdiletEvidenceType {
  MESSAGE
  ORDER_EVENT
  PAYMENT_EVENT
  SHIPMENT_INCIDENT
  DRIVER_STATUS
  PROVIDER_RESPONSE
  CUSTOMER_FEEDBACK
  MANAGER_NOTE
  SYSTEM_LOG
  OTHER
}

// Trust class per evidence item (spec s.13's "reliability/trust class").
enum AdiletEvidenceTrust {
  LOW
  MEDIUM
  HIGH
}

// Separates a claim from a verified fact everywhere (spec s.14) — an
// individual evidence item's own status, distinct from AdiletDecision's
// verifiedFacts/disputedFacts summary of the whole case.
enum AdiletFactStatus {
  CLAIM
  VERIFIED_FACT
  DISPUTED
}

enum AdiletDecisionOutcome {
  NO_VIOLATION
  RESOLVED_NO_SANCTION
  WARNING
  SANCTION_APPLIED
  INSUFFICIENT_EVIDENCE
  ESCALATED_TO_DIRECTOR
}

// Who a sanction is against. DRIVER = passenger-side Driver; EXECUTOR =
// Sapar's cargo DeliveryExecutor; CLIENT = passenger or cargo sender.
enum AdiletSubjectType {
  CLIENT
  DRIVER
  EXECUTOR
}

// Union of both proportional step-ladders from spec s.5 (client:
// DEESCALATION..BLOCKED; driver/executor: ADVISORY..SUSPENDED, sharing
// FORMAL_WARNING/BLOCKED) in one enum — the policy engine restricts which
// values are valid for a given AdiletSubjectType, so a single enum avoids
// duplicating FORMAL_WARNING/BLOCKED across two near-identical types.
enum AdiletSanctionType {
  DEESCALATION
  EXPLANATION
  FORMAL_WARNING
  TEMPORARY_RESTRICTION
  TEMPORARY_SUSPENSION
  BLOCKED
  ADVISORY
  RELIABILITY_PENALTY
  LIMITED_ACCESS
  SUSPENDED
}

enum AdiletSanctionStatus {
  ACTIVE
  EXPIRED
  REVERSED
}

// Exact statuses from spec s.17.
enum AdiletAppealStatus {
  NO_APPEAL
  APPEAL_AVAILABLE
  APPEAL_REQUESTED
  UNDER_REVIEW
  UPHELD
  MODIFIED
  OVERTURNED
}

model AdiletCase {
  id         String           @id @default(cuid())
  caseType   AdiletCaseType
  severity   AdiletSeverity   @default(NORMAL)
  status     AdiletCaseStatus @default(OPEN)
  reviewMode AdiletReviewMode @default(ADILET_REVIEW)

  // Escalation origin (spec s.2) — which agent/actor opened this case.
  sourceAgent  AgentName?
  openedByType ActorType
  openedById   String?

  // Loose string references only, never a Prisma relation, so Adilet stays
  // decoupled from Passenger/Driver/DeliveryExecutor/Shipment schema churn
  // (spec s.61 step 7's "minimally-coupled domain architecture").
  relatedUserId     String?
  relatedExecutorId String?
  shipmentId        String?
  tripId            String?
  paymentId         String?
  managerContext    String?

  summary         String
  allegation      String
  evidenceSummary String?
  appealStatus    AdiletAppealStatus @default(NO_APPEAL)

  // Caller-supplied dedupe key (e.g. "SAPAR:<shipmentId>:NO_SHOW") so a
  // retried escalation event can never open a second case (spec s.34).
  sourceEventKey String? @unique

  openedAt   DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  evidence  AdiletEvidence[]
  decisions AdiletDecision[]
  sanctions AdiletSanction[]
  appeals   AdiletAppeal[]

  @@index([status, severity])
  @@index([relatedExecutorId, status])
  @@index([relatedUserId, status])
  @@index([shipmentId])
  @@index([caseType, status])
  @@index([openedAt])
}

model AdiletEvidence {
  id     String     @id @default(cuid())
  caseId String
  case   AdiletCase @relation(fields: [caseId], references: [id])

  type        AdiletEvidenceType
  factStatus  AdiletFactStatus    @default(CLAIM)
  trust       AdiletEvidenceTrust @default(MEDIUM)
  source      String // e.g. "AuditLogEntry", "SupportCase", "ShipmentIncident", "manager"
  sourceId    String? // id of the source record, when one exists
  occurredAt  DateTime
  description String

  createdAt DateTime @default(now())

  @@index([caseId])
}

model AdiletDecision {
  id     String     @id @default(cuid())
  caseId String
  case   AdiletCase @relation(fields: [caseId], references: [id])

  outcome               AdiletDecisionOutcome
  findings              String
  verifiedFacts         String[]
  disputedFacts         String[]
  insufficientEvidence  Boolean               @default(false)
  policyBasis           String
  proportionalityReason String?
  duration              String?
  appealAllowed         Boolean               @default(true)
  reviewAfter           DateTime?

  decidedByActorType ActorType
  decidedByActorId   String?
  decidedAt          DateTime  @default(now())

  // Self-relation preserving history on overturn (spec s.19): a review
  // decision points back at the original it supersedes; the original is
  // never deleted or edited in place.
  supersedesDecisionId String?         @unique
  supersedesDecision   AdiletDecision? @relation("AdiletDecisionRevision", fields: [supersedesDecisionId], references: [id])
  revisedBy            AdiletDecision? @relation("AdiletDecisionRevision")

  sanction        AdiletSanction?
  appeals         AdiletAppeal[]  @relation("AdiletAppealDecision")
  appealReviewFor AdiletAppeal?   @relation("AdiletAppealReviewDecision")

  @@index([caseId])
}

model AdiletSanction {
  id     String     @id @default(cuid())
  caseId String
  case   AdiletCase @relation(fields: [caseId], references: [id])

  // One decision produces at most one sanction — the unique constraint IS
  // the idempotency guard for spec s.34 (a repeated "apply sanction" call
  // for the same decision can never double-apply).
  decisionId String         @unique
  decision   AdiletDecision @relation(fields: [decisionId], references: [id])

  subjectType  AdiletSubjectType
  subjectId    String
  sanctionType AdiletSanctionType
  status       AdiletSanctionStatus @default(ACTIVE)
  reason       String

  startAt        DateTime  @default(now())
  expiresAt      DateTime?
  reversedAt     DateTime?
  reversedReason String?

  createdAt DateTime @default(now())

  @@index([subjectType, subjectId, status])
  @@index([status, expiresAt])
  @@index([caseId])
}

model AdiletAppeal {
  id     String     @id @default(cuid())
  caseId String
  case   AdiletCase @relation(fields: [caseId], references: [id])

  decisionId String
  decision   AdiletDecision @relation("AdiletAppealDecision", fields: [decisionId], references: [id])

  status AdiletAppealStatus @default(APPEAL_REQUESTED)

  requestedByActorType ActorType
  requestedById        String?
  requestReason        String

  reviewedAt        DateTime?
  reviewedByActorId String?
  reviewNotes       String?

  // The review's own AdiletDecision, when one is issued (spec s.19: both
  // ORIGINAL_DECISION and REVIEW_DECISION are kept, never a blind overwrite).
  reviewDecisionId String?         @unique
  reviewDecision   AdiletDecision? @relation("AdiletAppealReviewDecision", fields: [reviewDecisionId], references: [id])

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([status])
}

// ==========================================================================
// TYYIN — RT's chief AI treasurer / central financial control circuit
// (AGENTS Tyyin spec s.0-s.73). Sits above Sapargul in the org chart: reads
// real bank data, reconciles it against ShipmentPayment/PaymentDestination
// (reused, never duplicated), and is the source that drives Sapargul's
// existing single-writer confirmation boundary (src/lib/sapargul/treasury.ts)
// from a verified real transaction instead of a human-reviewed receipt.
//
// Hard invariant (spec s.6/s.28/s.51): Tyyin's bank adapter interface
// (src/lib/tyyin/bank-adapter.ts) is structurally inbound-only — no
// transfer/payout/refund/withdrawal/debit/sendMoney method exists anywhere
// in its domain, including for OWNER_DIRECT_CALL. This is enforced by the
// TypeScript interface shape, not by a runtime permission check.
//
// TreasuryTransaction *is* the append-only central financial journal (spec
// s.10/s.13/s.65) — a second parallel ledger table would only duplicate it,
// so no separate "ledger" model is added. AuditLogEntry (agent: TYYIN,
// via emitTyyinEvent) remains the action/decision audit trail, consistent
// with every other RT AI Workforce agent in this codebase (no second event
// bus — see src/lib/sapargul/events.ts / src/lib/adilet/events.ts).
//
// AccountantCase mirrors AdiletCase's shape deliberately (Case + resolution
// fields in one model, no separate five-model split) — Tyyin never executes
// an outgoing action, so there is no enforcement/appeal ladder to model,
// only: escalate -> a human accountant acts outside this system -> the
// result is recorded here for audit, never triggered from here.

enum TreasuryDepartment {
  CARGO // Sapargul's live cargo/parcel cashier contour
  PASSENGER // modeled from day one (spec s.38); no passenger cashier is wired yet (spec s.60 exclusion)
  OTHER
}

enum TreasuryTransactionStatus {
  RECEIVED // just ingested, not yet reconciled
  MATCHED // reconciled to exactly one ShipmentPayment and confirmed via treasury.ts
  NEEDS_MANUAL_RECONCILIATION // no/ambiguous/currency-mismatched reference — never guessed, never dropped
}

enum AccountantCaseType {
  REFUND_REQUIRED
  OVERPAYMENT_RESOLUTION
  COMPENSATION_REVIEW
  WRONG_PAYMENT
  DUPLICATE_PAYMENT
  UNMATCHED_PAYMENT
  CUSTOMER_DISPUTE
  MANUAL_RECONCILIATION
  OTHER
}

enum AccountantCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Every real inbound bank transaction Tyyin ever sees (spec s.2/s.9/s.10) —
// the append-only source-of-truth journal. Rows are never deleted; a
// misreconciled row is corrected by updating its own status/notes, not by
// removal (spec s.65's "append-only where possible").
model TreasuryTransaction {
  id String @id @default(cuid())

  // Bank's own transaction id — the idempotency guard for duplicate
  // webhook/poll delivery (spec s.11/s.47's "duplicate webhook" race).
  externalTransactionId String             @unique
  accountRef            String // masked/alias account reference — never a full account/card number
  department            TreasuryDepartment @default(CARGO)

  amountSom Int
  currency  String @default("KGS")

  // Parsed from the bank statement narrative — the exact-match key
  // reconciliation.ts uses against ShipmentPayment.orderReference. Never
  // fuzzy-matched (spec s.44's "falls back to NEEDS_MANUAL_RECONCILIATION").
  paymentReference   String?
  counterpartyMasked String?

  transactionTime DateTime // when the bank recorded it
  receivedAt      DateTime @default(now()) // when Tyyin ingested it

  status TreasuryTransactionStatus @default(RECEIVED)

  matchedPaymentId    String?
  matchedAt           DateTime?
  reconciliationNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountantCases AccountantCase[]

  @@index([externalTransactionId])
  @@index([paymentReference])
  @@index([status])
  @@index([transactionTime])
  @@index([department])
  @@index([accountRef])
}

// Tyyin's escalation to a real human accountant (spec s.18-s.24) — Tyyin
// records what happened here; it never executes any outgoing action itself
// (no such method exists in its domain interface).
model AccountantCase {
  id         String               @id @default(cuid())
  caseType   AccountantCaseType
  status     AccountantCaseStatus @default(OPEN)
  department TreasuryDepartment   @default(CARGO)

  // Loose string references only (mirrors AdiletCase's decoupling choice,
  // spec s.61 step 7) — never a hard FK to ShipmentPayment, so Tyyin stays
  // structurally decoupled from Sapargul's schema evolving independently.
  relatedPaymentId     String?
  relatedTransactionId String?
  transaction          TreasuryTransaction? @relation(fields: [relatedTransactionId], references: [id])

  amountSom Int?
  currency  String @default("KGS")
  summary   String

  openedByType ActorType
  openedById   String?

  // Caller-supplied dedupe key (e.g. "TYYIN:OVERPAY:<transactionId>") so a
  // retried escalation can never open a second case for the same event
  // (mirrors AdiletCase.sourceEventKey, spec s.34's idempotency pattern).
  sourceEventKey String? @unique

  assignedAccountantId String?

  // What the accountant reports they did *outside* this system (e.g. sent a
  // refund via the bank's own app) — recorded, never triggered from here
  // (spec s.24's "records but never executes").
  resolutionType         String?
  resolutionSummary      String?
  resolutionRecordedAt   DateTime?
  resolutionRecordedById String?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, caseType])
  @@index([department, status])
  @@index([relatedPaymentId])
  @@index([relatedTransactionId])
  @@index([openedAt])
}

// ==========================================================================
// ARTUR — AI Director of Regional Trans / RT (AGENTS "Master Architecture:
// Unified AI Organization + Director Artur" spec). Sits above every
// specialist agent, below the Founder. Artur never becomes an authoritative
// database for specialist domains — every number in a brief/report traces
// back to a real read from Sapar/Sapargul/Tyyin/Adilet/passenger data (spec
// s.1/s.2/s.34); Artur's own models below only ever store Artur's *own*
// output (briefs, reports, initiatives, incidents, deliveries, job runs),
// never a second copy of another domain's authoritative state.
//
// Idempotency pattern (spec s.22/s.31): FounderBrief/WeeklyDirectorReport
// are keyed by their reporting period (reportDate / weekStartDate, both
// @unique) so a duplicate scheduler firing or restart can never create two
// briefs for the same day — mirrors TreasuryTransaction.externalTransactionId
// and AccountantCase.sourceEventKey elsewhere in this codebase.
// ScheduledJobRun additionally mirrors JolchuDataRefreshRun's RUNNING /
// SUCCEEDED / FAILED run-record pattern, unique per (jobName, periodKey), so
// a crashed-and-restarted cron invocation can detect a run already in
// flight/completed rather than duplicating side effects.
// ==========================================================================

// Deterministic severity ladder (spec s.19) — Claude may add reasoning on
// top of a signal, but the ladder itself is fixed application logic, never
// left to free-form LLM judgement.
enum Severity {
  INFO
  NORMAL
  ATTENTION
  HIGH
  CRITICAL
}

// Section 1 of the daily Founder Brief (spec s.10.1) — a coarser rollup of
// Severity for "how is the whole company doing right now".
enum RtStatus {
  NORMAL
  ATTENTION
  CRITICAL
}

enum ScheduledJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED
  RETRYING
  DEAD_LETTER
}

// Founder approval workflow for a weekly strategic initiative (spec s.16).
// Transitions are validated by src/lib/artur/initiatives.ts's explicit state
// table — an LLM is never allowed to assign one of these strings directly.
enum FounderInitiativeStatus {
  PROPOSED
  APPROVED
  REJECTED
  DEFERRED
  NEEDS_REVISION
  IN_PROGRESS
  COMPLETED
  MEASURED
}

enum EmergencyResolutionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// One row per scheduler execution attempt — the restart/duplicate-fire
// safety net for the 08:00 daily and Monday 10:00 weekly jobs (spec s.31).
model ScheduledJobRun {
  id String @id @default(cuid())

  jobName   String // "ARTUR_DAILY_BRIEF" | "ARTUR_WEEKLY_REPORT"
  // Bishkek-local period key the run is FOR — "YYYY-MM-DD" for daily,
  // "YYYY-MM-DD" (Monday) for weekly. The idempotency guard itself.
  periodKey String

  status      ScheduledJobStatus @default(RUNNING)
  triggeredBy String // "scheduler" | "manual"

  resultRefId String? // FounderBrief.id / WeeklyDirectorReport.id once known

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  errors     String[]

  @@unique([jobName, periodKey])
  @@index([jobName, status])
}

// The daily 08:00 Asia/Bishkek Founder Brief (spec s.9/s.10) — reproducible:
// once generated for a reportDate it is never silently regenerated with
// different numbers (spec s.29's "management data snapshot" requirement).
model FounderBrief {
  id String @id @default(cuid())

  reportDate String @unique // Bishkek-local "YYYY-MM-DD"

  overallStatus RtStatus

  // The 10 required sections (spec s.10), each a small structured object —
  // validated against src/lib/artur/types.ts's Zod schema before being
  // persisted (spec s.33). Never hand-assembled free text only.
  sections Json

  sourceSnapshotAt DateTime // when the underlying RT Core data was read
  generatedAt      DateTime @default(now())

  jobRunId String? // ScheduledJobRun.id, loose ref

  deliveries NotificationDelivery[] @relation("FounderBriefDeliveries")

  @@index([generatedAt])
}

// The Monday 10:00 Asia/Bishkek weekly report (spec s.11-s.15).
model WeeklyDirectorReport {
  id String @id @default(cuid())

  weekStartDate String @unique // Bishkek-local Monday "YYYY-MM-DD"
  weekEndDate   String // Bishkek-local Sunday "YYYY-MM-DD"

  // Week-over-week KPI table (spec s.12) — current/previous/absolute/percent/
  // status per KPI, computed by src/lib/artur/period.ts's pure functions.
  kpis     Json
  // "Problems of the week" (spec s.14) — array of structured problem entries.
  problems Json

  executiveSummary String

  sourceSnapshotAt DateTime
  generatedAt      DateTime @default(now())

  jobRunId String?

  initiatives DirectorInitiative[]
  deliveries  NotificationDelivery[] @relation("WeeklyReportDeliveries")

  @@index([generatedAt])
}

// Exactly 3 of these are created per WeeklyDirectorReport (spec s.15) —
// enforced by src/lib/artur/initiatives.ts, never left to chance. Each
// enters the Founder approval workflow independently (spec s.16); Artur
// never auto-implements one itself.
model DirectorInitiative {
  id String @id @default(cuid())

  reportId String
  report   WeeklyDirectorReport @relation(fields: [reportId], references: [id])

  title          String
  proposal       String
  whyNow         String
  evidence       String
  expectedEffect String
  complexity     String
  resources      String?
  risks          String
  priority       String
  successMetric  String

  status FounderInitiativeStatus @default(PROPOSED)

  proposedAt           DateTime  @default(now())
  decisionAt           DateTime?
  decisionByActorId    String?
  decisionNote         String?
  implementationResult String?
  measuredEffect       String?
  measuredAt           DateTime?

  @@index([reportId])
  @@index([status])
}

// Force-majeure / critical escalation to the Founder, reachable 24/7 (spec
// s.17/s.18) — independent of the daily/weekly cadence. sourceEventKey is
// the idempotency guard so a repeatedly-detected condition (e.g. the same
// discrepancy re-observed on every scheduler tick) opens exactly one
// incident, mirroring AdiletCase/AccountantCase's sourceEventKey pattern.
model EmergencyIncident {
  id String @id @default(cuid())

  source          AgentName?
  severity        Severity // HIGH or CRITICAL only — spec s.17 (validated in code)
  correlationId   String?
  relatedEntities Json?

  whatHappened              String
  currentStatus             String
  peopleOrdersMoneyAffected String?
  actionsTaken              String?
  immediateRisks            String?
  availableOptions          String?
  recommendation            String?
  decisionRequired          String?
  decisionDeadline          DateTime?

  founderResponse  String?
  resolutionStatus EmergencyResolutionStatus @default(OPEN)

  sourceEventKey String? @unique

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  deliveries NotificationDelivery[] @relation("EmergencyIncidentDeliveries")

  @@index([resolutionStatus, severity])
  @@index([detectedAt])
}

// NotificationGateway's persistence layer (spec s.30) — a clean delivery
// abstraction prepared now with NO real channel adapter wired (never fakes
// delivery: with no adapter configured, status simply becomes FAILED with an
// honest lastError, not DELIVERED). idempotencyKey prevents a retried
// generate-and-send from ever double-notifying the Founder for the same
// brief/report/incident (spec s.22).
model NotificationDelivery {
  id String @id @default(cuid())

  kind    String // "FOUNDER_DAILY_BRIEF" | "FOUNDER_WEEKLY_REPORT" | "FOUNDER_EMERGENCY_ALERT"
  channel String? // null until a real channel adapter (Telegram/WhatsApp/...) is wired

  founderBriefId      String?
  founderBrief        FounderBrief?         @relation("FounderBriefDeliveries", fields: [founderBriefId], references: [id])
  weeklyReportId      String?
  weeklyReport        WeeklyDirectorReport? @relation("WeeklyReportDeliveries", fields: [weeklyReportId], references: [id])
  emergencyIncidentId String?
  emergencyIncident   EmergencyIncident?    @relation("EmergencyIncidentDeliveries", fields: [emergencyIncidentId], references: [id])

  status        NotificationDeliveryStatus @default(PENDING)
  attempts      Int                        @default(0)
  lastAttemptAt DateTime?
  lastError     String?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
}

// ============================================================================
// RT OFFICE / CRM AUTO — supply<->demand awareness + Drive CRM automation.
// RT OFFICE never owns a Prisma model of its own: it is a read-only query +
// thin-write (re-triggering existing matching) layer over RT Core's existing
// Driver/DriverOffer/Match/Trip tables (src/lib/rt-office). CRM Auto owns
// exactly this one append-only model.
// ============================================================================

enum DriveCrmEventType {
  OPERATIONAL_ETA
  BREAKDOWN_INCIDENT
  BACKHAUL_OPPORTUNITY
  OPERATIONAL_HISTORY
  // An exceptional, explicitly audited correction of an earlier event (e.g.
  // a false breakdown report). Never overwrites or deletes the original row
  // — it is a new append-only event that references the corrected one via
  // correctsEventId, preserving full historical auditability.
  CORRECTION
}

enum DriveCrmIncidentStatus {
  OPEN
  RESOLVED
}

// CRM Auto's own append-only operational-history log. This is NOT a
// competing source of truth for Driver/DriverOffer/Match/Trip state — those
// remain RT Core's exclusive write surface (see matching/orchestrate.ts).
// DriveCrmEvent only ever RECORDS a fact already verified elsewhere (RT
// Core state, or a verified upstream signal such as Jolchu for ETA); CRM
// Auto never computes its own ETA/incident/backhaul facts from scratch.
// tripId/offerId are loose correlation ids (same pattern as
// MiraConversation.collectedFields.pendingDeclineMatchId) — deliberately NOT
// a Prisma relation, so this model can never become a second write path
// onto Trip/DriverOffer. Rows are NEVER updated or deleted after creation
// (see crm-auto/boundary.test.ts) — a mistaken event is corrected by
// appending a CORRECTION event that references it via correctsEventId,
// never by mutating history.
model DriveCrmEvent {
  id              String                  @id @default(cuid())
  driverId        String
  driver          Driver                  @relation(fields: [driverId], references: [id])
  tripId          String?
  offerId         String?
  eventType       DriveCrmEventType
  incidentStatus  DriveCrmIncidentStatus? // only meaningful when eventType = BREAKDOWN_INCIDENT
  etaMinutes      Int? // only meaningful when eventType = OPERATIONAL_ETA; must come from a verified calculation (e.g. Jolchu), never invented
  source          String // e.g. "JOLCHU", "DRIVER_REPORT", "RT_OFFICE", "SYSTEM" — never blank; feeds RT OFFICE's required "data freshness/source" fact
  details         Json?
  // Loose correlation id (not a self-relation, same reasoning as tripId/
  // offerId) to the DriveCrmEvent this CORRECTION event corrects. Only
  // meaningful when eventType = CORRECTION.
  correctsEventId String?
  idempotencyKey  String                  @unique // guards against duplicate webhook/event delivery re-recording the same event

  createdAt DateTime @default(now())

  @@index([driverId, eventType, createdAt])
  @@index([driverId, eventType, incidentStatus])
  @@index([correctsEventId])
}

// ============================================================================
// Market Acquisition Contractors — Driver/Passenger/Delivery-Business
// acquisition + Delivery CRM. See docs/AGENT_CONSTITUTION.md s.3 and
// docs/RT_ORGANIZATION.md s.6 for the full boundary writeup.
//
// RT OFFICE DOES NOT SEARCH FOR DRIVERS: the contractors create supply/demand
// flow, RT OFFICE (existing, unchanged) manages verified supply. None of the
// models below are a second Driver/Passenger/Shipment/Partner source of
// truth — DRIVER_CONTRACTOR reuses ScoutCandidate (SCOUT's existing model)
// for driver prospects rather than inventing a competing one; only
// PassengerProspect and BusinessProspect are genuinely new identities (no
// existing model covers "someone who might become a passenger/delivery
// customer but hasn't yet").
// ============================================================================

// Shared across all three acquisition sources — mirrors ScoutSourceType but
// is intentionally its own enum (not reused) since PUBLIC_AD covers business
// advertisement sourcing that has no Scout equivalent, and coupling it to
// Scout's enum would make a future Scout-only addition leak into contractors
// that have nothing to do with driver sightings.
enum AcquisitionSourceType {
  TELEGRAM_GROUP
  WHATSAPP_GROUP
  LALAFO
  PUBLIC_AD
  MANUAL_IMPORT
  INTERNAL
}

enum AcquisitionProspectType {
  DRIVER
  PASSENGER
  BUSINESS
  DELIVERY_EXECUTOR
  CARGO_CARRIER
}

// Prospecting Core's handoff lifecycle (docs/architecture/prospecting.md).
// READY never implies acceptance; ownership transfers to the receiving
// internal contour ONLY on ACCEPTED. ACCEPTED/REJECTED/DUPLICATE are
// terminal — see src/lib/prospecting/handoff.ts's canTransitionHandoff for
// the enforced legal-transition table.
enum HandoffStatus {
  READY
  ACCEPTED
  REJECTED
  NEEDS_MORE_INFO
  DUPLICATE
}

enum DeliveryExecutorProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  HANDED_OFF
  DECLINED
  SPAM
}

enum CargoCarrierProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  HANDED_OFF
  DECLINED
  SPAM
}

// Master spec s.5's honesty requirement: an outreach adapter must never
// report a fabricated successful send. SENT is real-delivery-confirmed;
// DRY_RUN/SANDBOX/NO_PROVIDER_CONFIGURED are all honest non-delivery states,
// never silently coerced into SENT.
enum OutreachStatus {
  SENT
  DRY_RUN
  SANDBOX
  NO_PROVIDER_CONFIGURED
  RATE_LIMITED
  DUPLICATE
  DO_NOT_CONTACT
  FAILED
}

enum PassengerProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED // became a real passenger via Mira — see passenger-contractor/bridge.ts
  DECLINED
  SPAM
}

enum BusinessCategory {
  GROCERY
  HOUSEHOLD_GOODS
  CLOTHING
  ELECTRONICS
  AUTO_GOODS
  BUILDING_MATERIALS
  FURNITURE
  FLOWERS
  PHARMACY
  MARKET_SELLER
  SOCIAL_COMMERCE
  ONLINE_STORE
  WHOLESALE
  RETAIL
  OTHER
}

enum BusinessProspectStatus {
  PROSPECT
  CONTACTED
  QUALIFIED
  PARTNERED
  DECLINED
  CHURNED
}

enum DeliveryCrmEventType {
  OUTREACH_SENT
  QUALIFIED
  PARTNERSHIP_AGREED
  HANDOFF_TO_OPERATIONS // business is now live in Sapar's operational delivery flow
  LAST_MILE_STATUS
  COMPLETION
  INCIDENT
  CORRECTION
}

// Shared, append-only outreach ledger — infrastructure like AuditLogEntry,
// not an exclusive business capability, so all three contractors may append
// to it without a capabilities collision (see src/lib/artur/collisions.ts).
// Provides the master spec s.5 safety set in one place: idempotency
// (idempotencyKey unique), dedup + rate-limiting (query by prospectType +
// prospectRef + createdAt), do-not-contact (doNotContact flag persists once
// set), and source traceability (sourceType/sourceRef always recorded).
model AcquisitionOutreachEvent {
  id              String                  @id @default(cuid())
  contractorAgent AgentName
  prospectType    AcquisitionProspectType
  // Loose correlation id (ScoutCandidate.id / PassengerProspect.id /
  // BusinessProspect.id) — deliberately not a Prisma relation so this shared
  // log never becomes a write path onto any prospect model directly.
  prospectRef     String
  channel         Channel
  sourceType      AcquisitionSourceType
  sourceRef       String? // e.g. TelegramGroup id or free-text source label
  status          OutreachStatus
  messageSummary  String // never the full message body verbatim — audit-safe summary only
  doNotContact    Boolean                 @default(false)
  // Normalized cross-type identity signal (phone/handle — see
  // src/lib/prospecting/identity.ts) so an opt-out recorded by one
  // acquisition contractor blocks every other contractor from reaching the
  // same real person under a different prospectType/prospectRef. Optional:
  // absent for any caller that hasn't supplied one, never backfilled.
  contactFingerprint String?
  idempotencyKey  String                  @unique
  createdAt       DateTime                @default(now())

  @@index([prospectType, prospectRef, createdAt])
  @@index([contractorAgent, createdAt])
  @@index([contactFingerprint])
}

// PASSENGER_CONTRACTOR's exclusive write surface — a prospect who has shown
// passenger-shaped intent on a permitted public source but has not yet
// messaged RT directly. Deliberately NOT a TripRequest/Passenger row: those
// stay Mira/RT Core's exclusive write surface, created only once the real
// person actually messages RT (spec: "Passenger -> handoff to Mira").
model PassengerProspect {
  id                     String                  @id @default(cuid())
  sourceType             AcquisitionSourceType
  sourceGroupId          String?
  sourceText             String
  rawPhone               String?
  rawTelegramUsername    String?
  rawRouteText           String?
  rawOriginStopId        String?
  rawDestinationStopId   String?
  rawTravelDate          DateTime?               @db.Date
  normalizedPhone        String?
  status                 PassengerProspectStatus @default(NEW)
  convertedTripRequestId String? // loose correlation id, set only after a real TripRequest exists — see bridge.ts
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([normalizedPhone])
}

// DELIVERY_CONTRACTOR's exclusive write surface for identity/lifecycle.
// Explicitly distinct from Partner (RT's logistics/fleet partner directory)
// and Shipment (Sapar's individual cargo execution record) — this tracks the
// business RELATIONSHIP (prospect -> qualified -> partnered), never an
// individual delivery order.
model BusinessProspect {
  id                    String                 @id @default(cuid())
  sourceType            AcquisitionSourceType
  sourceRef             String?
  sourceText            String
  businessName          String?
  category              BusinessCategory
  contactPhone          String?
  contactHandle         String?
  deliveryPotentialNote String?
  status                BusinessProspectStatus @default(PROSPECT)
  linkedPartnerId       String? // set once ops onboards them as a real Partner row (RT Network) — loose correlation id, never a relation (Partner stays RT Network's own write surface)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  events                DeliveryCrmEvent[]

  @@index([status, createdAt])
  @@index([category, status])
}

// Delivery CRM's own append-only event log — same append-only/CORRECTION
// pattern as CRM Auto's DriveCrmEvent. Never a second Sapar execution
// engine: SAPAR remains cargo/delivery operational execution owner: once a
// HANDOFF_TO_OPERATIONS event is appended, actual shipments flow through
// Sapar's existing Shipment model, not through this log.
model DeliveryCrmEvent {
  id                 String               @id @default(cuid())
  businessProspectId String
  businessProspect   BusinessProspect     @relation(fields: [businessProspectId], references: [id])
  eventType          DeliveryCrmEventType
  details            Json?
  source             String
  correctsEventId    String?
  idempotencyKey     String               @unique
  createdAt          DateTime             @default(now())

  @@index([businessProspectId, eventType, createdAt])
  @@index([correctsEventId])
}

// DELIVERY_EXECUTOR_CONTRACTOR's exclusive write surface (Contragent #3).
// Explicitly distinct from ScoutCandidate/Driver (passenger-network driver
// supply) and from Sapar's own operational executor-assignment records — a
// delivery-executor prospect is a DIFFERENT commercial capability even when
// the same human could plausibly do both.
model DeliveryExecutorProspect {
  id                  String                          @id @default(cuid())
  sourceType          AcquisitionSourceType
  sourceGroupId       String?
  sourceRef           String?
  sourceText          String
  rawPhone            String?
  rawTelegramUsername String?
  rawVehicleText      String?
  rawZonesText        String?
  normalizedPhone     String?
  status              DeliveryExecutorProspectStatus @default(NEW)
  handedOffAt         DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([status, createdAt])
  @@index([normalizedPhone])
}

// CARGO_CARRIER_CONTRACTOR's exclusive write surface (Contragent #4).
// Capability fields below are unverified prospect CLAIMS only — never
// promoted automatically into Partner Registry's TransportAsset facts,
// which require normal onboarding/verification (docs/architecture/partner-registry.md).
model CargoCarrierProspect {
  id                       String                      @id @default(cuid())
  sourceType               AcquisitionSourceType
  sourceGroupId            String?
  sourceRef                String?
  sourceText               String
  rawPhone                 String?
  rawTelegramUsername      String?
  rawVehicleText           String?
  rawCapacityText          String?
  rawRouteText             String?
  rawTemperatureCapability Boolean?
  rawBackhaulText          String?
  normalizedPhone          String?
  status                   CargoCarrierProspectStatus @default(NEW)
  handedOffAt              DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([status, createdAt])
  @@index([normalizedPhone])
}

// Prospecting Core's own, additive persistence for the shared handoff
// lifecycle (docs/architecture/prospecting.md). Never a second source of
// truth for any contragent's prospect data — prospectRef is a loose
// correlation id into whichever prospect model actually owns that record
// (PassengerProspect / ScoutCandidate / BusinessProspect /
// DeliveryExecutorProspect / CargoCarrierProspect), same idiom as
// AcquisitionOutreachEvent.prospectRef. Creating a READY row never implies
// acceptance; ownership transfers to targetAgentOrDepartment only once
// status becomes ACCEPTED (src/lib/prospecting/handoff.ts).
model ProspectHandoff {
  id                      String                  @id @default(cuid())
  prospectType            AcquisitionProspectType
  prospectRef             String
  sourceAgent             AgentName
  targetAgentOrDepartment String
  status                  HandoffStatus           @default(READY)
  expressedInterest       String?
  summary                 String?
  contactData             String?
  requestedService        String?
  availableCapabilities   String[]
  conversationReference   String?
  sourceReferences        String[]
  contactFingerprint      String?
  decisionNote            String?
  decidedBy               String?
  idempotencyKey          String                  @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  acceptedAt              DateTime?
  rejectedAt              DateTime?

  @@index([prospectType, prospectRef, status])
  @@index([status, createdAt])
  @@index([targetAgentOrDepartment, status])
  @@index([contactFingerprint])
}
