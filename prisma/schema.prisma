// Regional Trans RT — dispatching engine data model.
// Regional Trans is an information intermediary, not a carrier: the carriage
// contract is formed directly between passenger and driver once a match is confirmed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  RU
  KY
  EN
}

enum Channel {
  WHATSAPP
  TELEGRAM_BOT
  TELEGRAM_GROUP
}

enum DriverStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum RequestStatus {
  PENDING
  MATCHING
  MATCHED
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum OfferStatus {
  OPEN
  PARTIALLY_FILLED
  FULL
  CLOSED
  CANCELLED
}

enum MatchStatus {
  PROPOSED_TO_DRIVER
  AWAITING_DRIVER
  AWAITING_PASSENGER
  CONFIRMED
  DECLINED_BY_DRIVER
  DECLINED_BY_PASSENGER
  EXPIRED
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MessageParseResult {
  PASSENGER_REQUEST
  DRIVER_OFFER
  CONFIRMATION_REPLY
  UNRECOGNIZED
  COMMAND
  IGNORED_NOT_ALLOWED
}

enum ActorType {
  AGENT
  DISPATCHER
  SYSTEM
}

// RT AI Workforce — named specialist agents orchestrated by RT Command.
enum AgentName {
  COMMAND
  PASSENGER
  DRIVER
  MATCH
  ROUTE
  TRUST
  PAY
  SUPPORT
  PARCEL
  SCOUT
  QUALITY
  ANALYTICS
  NETWORK
}

enum PaymentMode {
  DRIVER_DIRECT_RT_BALANCE // driver collects fare in person; RT debits driver's RT Balance for the commission
  THROUGH_RT // passenger pays RT; RT keeps commission and pays out the remainder to the driver
}

enum LedgerEntryType {
  COMMISSION_CHARGE
  TOPUP
  PAYMENT_COLLECTED
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum LedgerEntryStatus {
  POSTED
  REVERSED
}

enum ParcelStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  DISPUTED
}

enum ScoutSourceType {
  TELEGRAM_GROUP
  WHATSAPP_GROUP
  LALAFO
  MANUAL_IMPORT
  INTERNAL
}

enum ScoutReviewStatus {
  PENDING_REVIEW
  AUTO_LINKED
  MANUALLY_LINKED
  REJECTED
  NEW_DRIVER_CREATED
}

enum DriverCategory {
  UNKNOWN
  OCCASIONAL
  REGULAR
  ANCHOR
  DISPATCHER_FLEET
}

enum SupportCaseType {
  DRIVER_NO_SHOW
  PASSENGER_NO_SHOW
  CANCELLATION
  LATE
  DISPUTE
  REFUND_REQUEST
  ROUTE_CHANGE
  OTHER
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum PartnerType {
  DRIVER_FLEET
  DISPATCHER
  RT_POINT
  CAFE
  GAS_STATION
  SUPERMARKET
  COURIER
  LAST_MILE
  OTHER
}

// Ordered corridor of stops, e.g. Bishkek -> Balykchy -> Cholpon-Ata -> Bosteri -> Karakol.
// Direction of travel is inferred by comparing `order` of origin vs destination stop.
model Corridor {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "bishkek-karakol"
  nameRu    String
  nameKy    String
  nameEn    String
  isActive  Boolean  @default(true)
  stops     Stop[]
  createdAt DateTime @default(now())
}

model Stop {
  id         String   @id @default(cuid())
  corridorId String
  corridor   Corridor @relation(fields: [corridorId], references: [id])
  key        String // e.g. "bishkek", "balykchy", "cholpon-ata", "bosteri", "karakol"
  nameRu     String
  nameKy     String
  nameEn     String
  order      Int // position along the corridor, ascending
  aliases    String[] // free-text aliases/spellings used by NLP matching

  requestsAsOrigin      TripRequest[] @relation("RequestOrigin")
  requestsAsDestination TripRequest[] @relation("RequestDestination")
  offersAsOrigin        DriverOffer[] @relation("OfferOrigin")
  offersAsDestination   DriverOffer[] @relation("OfferDestination")
  parcelsAsOrigin       Parcel[]      @relation("ParcelOrigin")
  parcelsAsDestination  Parcel[]      @relation("ParcelDestination")
  partners              Partner[]

  @@unique([corridorId, key])
  @@index([corridorId, order])
}

model Passenger {
  id             String    @id @default(cuid())
  whatsappId     String    @unique // WhatsApp wa_id (phone-linked)
  phone          String? // E.164, may equal whatsappId; kept private, only shared on confirmed match
  name           String?
  preferredLang  Language  @default(RU)
  isBlocked      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  requests       TripRequest[]
  trips          Trip[]
}

model Driver {
  id                String       @id @default(cuid())
  telegramUserId    String       @unique
  telegramUsername  String?
  phone             String? // private, shared with passenger only on confirmed match
  name              String?
  carModel          String?
  carPlate          String?
  preferredLang     Language     @default(RU)
  status            DriverStatus @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?
  verifiedByAdminId String?
  isFemale          Boolean? // self-declared, opt-in; used only to honor passenger safety preferences
  ratingAvg         Float?
  ratingCount       Int          @default(0)
  complaintsCount   Int          @default(0)
  repeatScore       Int          @default(0) // RT Scout: signals of being a recurring driver on this corridor
  category          DriverCategory @default(UNKNOWN)
  lastScoutSeenAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  offers            DriverOffer[]
  trips             Trip[]
  rtBalance         RtBalance?
  ledgerEntries     LedgerEntry[]
  scoutCandidates   ScoutCandidate[]
  parcels           Parcel[]
}

model TripRequest {
  id             String        @id @default(cuid())
  passengerId    String
  passenger      Passenger     @relation(fields: [passengerId], references: [id])
  originStopId   String
  origin         Stop          @relation("RequestOrigin", fields: [originStopId], references: [id])
  destinationStopId String
  destination    Stop          @relation("RequestDestination", fields: [destinationStopId], references: [id])
  travelDate     DateTime      @db.Date
  timeWindowStart String? // "HH:mm", free-form time-of-day preference
  timeWindowEnd   String?
  seats          Int           @default(1)
  luggage        String? // free-text luggage description
  pickupPoint    String? // free-text pickup detail within origin stop
  femaleOnlyDriver       Boolean @default(false) // safety preference: only propose to a driver who declared isFemale
  travelingWithChildren  Boolean @default(false)
  status         RequestStatus @default(PENDING)
  sourceChannel  Channel       @default(WHATSAPP)
  rawMessageId   String?
  rawMessage     RawMessage?   @relation(fields: [rawMessageId], references: [id])
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  matches        Match[]

  @@index([status, travelDate])
  @@index([originStopId, destinationStopId, travelDate])
}

model DriverOffer {
  id                String      @id @default(cuid())
  driverId          String
  driver            Driver      @relation(fields: [driverId], references: [id])
  originStopId      String
  origin            Stop        @relation("OfferOrigin", fields: [originStopId], references: [id])
  destinationStopId String
  destination       Stop        @relation("OfferDestination", fields: [destinationStopId], references: [id])
  travelDate        DateTime    @db.Date
  timeWindowStart   String?
  timeWindowEnd     String?
  seatsTotal        Int
  seatsAvailable    Int
  status            OfferStatus @default(OPEN)
  sourceChannel     Channel     @default(TELEGRAM_BOT)
  rawMessageId      String?
  rawMessage        RawMessage? @relation(fields: [rawMessageId], references: [id])
  isReturnLeg       Boolean     @default(false)
  generatedFromTripId String?
  generatedFromTrip  Trip?      @relation("ReturnLegSource", fields: [generatedFromTripId], references: [id])
  expiresAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  matches           Match[]
  trips             Trip[]

  @@index([status, travelDate])
  @@index([originStopId, destinationStopId, travelDate])
}

model Match {
  id                  String      @id @default(cuid())
  tripRequestId       String
  tripRequest         TripRequest @relation(fields: [tripRequestId], references: [id])
  driverOfferId       String
  driverOffer         DriverOffer @relation(fields: [driverOfferId], references: [id])
  status              MatchStatus @default(PROPOSED_TO_DRIVER)
  score               Float? // internal ranking score for candidate selection
  proposedToDriverAt  DateTime?
  driverRespondedAt   DateTime?
  proposedToPassengerAt DateTime?
  passengerRespondedAt DateTime?
  confirmedAt         DateTime?
  contactRevealedAt   DateTime?
  declineReason       String?
  createdAt           DateTime    @default(now())
  trip                Trip?

  @@index([status])
}

model Trip {
  id                String      @id @default(cuid())
  matchId           String      @unique
  match             Match       @relation(fields: [matchId], references: [id])
  driverId          String
  driver            Driver      @relation(fields: [driverId], references: [id])
  passengerId       String
  passenger         Passenger   @relation(fields: [passengerId], references: [id])
  driverOfferId     String
  driverOffer       DriverOffer @relation(fields: [driverOfferId], references: [id])
  status            TripStatus  @default(SCHEDULED)
  seats             Int         @default(1) // snapshot of TripRequest.seats at confirmation, for commission/analytics
  paymentMode       PaymentMode?
  totalFareSom      Int? // optional, only meaningful for PaymentMode.THROUGH_RT
  commissionSom     Int? // snapshot of the commission charged for this trip once billed
  commissionChargedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime    @default(now())
  returnLegOffers   DriverOffer[] @relation("ReturnLegSource")
  ledgerEntries     LedgerEntry[]
  supportCases      SupportCase[]
  parcels           Parcel[]

  @@index([status])
}

// One row per driver: running balance of commission owed to RT (negative = driver owes RT).
model RtBalance {
  id           String   @id @default(cuid())
  driverId     String   @unique
  driver       Driver   @relation(fields: [driverId], references: [id])
  balanceSom   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// Append-only commission/payment ledger. Balance-affecting entries also update RtBalance.balanceSom
// transactionally; PAYMENT_COLLECTED/PAYOUT are informational records of the THROUGH_RT settlement flow.
model LedgerEntry {
  id          String            @id @default(cuid())
  driverId    String
  driver      Driver            @relation(fields: [driverId], references: [id])
  tripId      String?
  trip        Trip?             @relation(fields: [tripId], references: [id])
  type        LedgerEntryType
  status      LedgerEntryStatus @default(POSTED)
  paymentMode PaymentMode?
  amountSom   Int // signed: negative = debit from driver's RT Balance, positive = credit
  description String?
  actorType   ActorType
  actorId     String?
  createdAt   DateTime          @default(now())
  reversedAt  DateTime?

  @@index([driverId, createdAt])
  @@index([tripId])
}

model Parcel {
  id                    String       @id @default(cuid())
  senderName            String?
  senderContact         String // WhatsApp id, phone, or Telegram username of the sender
  receiverName          String?
  receiverContact       String
  originStopId          String
  origin                Stop         @relation("ParcelOrigin", fields: [originStopId], references: [id])
  destinationStopId     String
  destination           Stop         @relation("ParcelDestination", fields: [destinationStopId], references: [id])
  sizeType              String? // free-text: "document" | "small bag" | "box" etc.
  description           String?
  priceSom              Int?
  driverId              String?
  driver                Driver?      @relation(fields: [driverId], references: [id])
  tripId                String?
  trip                  Trip?        @relation(fields: [tripId], references: [id])
  status                ParcelStatus @default(PENDING)
  pickupConfirmedAt     DateTime?
  deliveryConfirmedAt   DateTime?
  cancelReason          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status, createdAt])
}

// RT Scout: raw driver sightings imported from Telegram/WhatsApp groups, Lalafo, or manual entry.
// Never auto-merged into a Driver record above a low confidence threshold — always reviewable.
model ScoutCandidate {
  id                     String            @id @default(cuid())
  sourceType             ScoutSourceType
  sourceGroupId          String? // TelegramGroup.id or free-text source label
  sourceText             String // raw announcement text, kept for audit/manual review
  rawPhone               String?
  rawTelegramUsername    String?
  rawName                String?
  rawCarModel            String?
  rawCarPlate            String?
  rawRouteText           String?
  rawOriginStopId        String?
  rawDestinationStopId   String?
  rawTravelDate          DateTime?         @db.Date
  rawPriceSom            Int?
  rawSeats               Int?
  extractionConfidence   Float?
  normalizedPhone        String? // digits-only, used as a dedup signal
  reviewStatus           ScoutReviewStatus @default(PENDING_REVIEW)
  matchCandidates        Json? // top scored Driver matches: [{ driverId, confidence, signals }]
  linkedDriverId         String?
  linkedDriver           Driver?           @relation(fields: [linkedDriverId], references: [id])
  reviewedByAdminId      String?
  reviewedAt             DateTime?
  createdAt              DateTime          @default(now())

  @@index([reviewStatus, createdAt])
  @@index([normalizedPhone])
}

model SupportCase {
  id            String            @id @default(cuid())
  tripId        String?
  trip          Trip?             @relation(fields: [tripId], references: [id])
  caseType      SupportCaseType
  status        SupportCaseStatus @default(OPEN)
  openedByType  ActorType
  openedById    String?
  description   String?
  resolution    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  resolvedAt    DateTime?
  escalatedAt   DateTime?

  @@index([status, createdAt])
}

// RT Network: partner directory (fleets, dispatchers, RT Points, last-mile partners, etc).
model Partner {
  id           String      @id @default(cuid())
  type         PartnerType
  name         String
  contactPhone String?
  contactHandle String?
  stopId       String?
  stop         Stop?       @relation(fields: [stopId], references: [id])
  notes        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
}

// Telegram groups the agent is allowed to passively read, connected with admin consent.
model TelegramGroup {
  id              String   @id @default(cuid())
  chatId          String   @unique
  title           String?
  addedByAdminId  String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  rawMessages     RawMessage[]
}

// Every inbound message the agent ingests, for audit + debugging NLP extraction.
model RawMessage {
  id                  String              @id @default(cuid())
  channel             Channel
  chatId              String
  telegramGroupId     String?
  telegramGroup       TelegramGroup?      @relation(fields: [telegramGroupId], references: [id])
  senderId            String
  text                String
  detectedLanguage    Language?
  parseResult         MessageParseResult?
  extractionConfidence Float?
  extractionRaw       Json?
  createdAt           DateTime            @default(now())
  tripRequests        TripRequest[]
  driverOffers        DriverOffer[]

  @@index([channel, chatId, createdAt])
}

model AuditLogEntry {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String? // dispatcher user id, or "agent"/"system"
  agentName  AgentName? // which RT AI Workforce agent produced this entry, if actorType = AGENT
  traceId    String? // correlation id shared by every agent invocation within one RT Command run
  action     String // e.g. "match.proposed", "match.confirmed", "contact.revealed", "dispatcher.override"
  entityType String // e.g. "Match", "Trip", "TripRequest"
  entityId   String
  details    Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([traceId])
}

model DispatcherUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("dispatcher") // "dispatcher" | "admin"
  createdAt    DateTime @default(now())
}
